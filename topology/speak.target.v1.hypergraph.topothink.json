    {"id": "engine:gcloud-chirp3", "attrs": {"label": "Google Cloud Chirp 3 HD", "i2t:kind": "engine", "vendor": "Google Cloud", "deployment": "cloud-api", "config-value": "gcloud", "voice-prefix": "en-US-Chirp3-HD-"}},
