#!/usr/bin/env bash
# speak — persona-driven text-to-speech with narration intelligence
# https://github.com/haroldyoung/speak
#
# CLEAN-SLATE REWRITE (feat/engine-persona-rewrite). Strangler refactor of the
# original 939-line driver: orchestration preserved verbatim; the per-engine
# synthesis bodies now live in engines/<engine>.{sh,py} per engines/CONTRACT.md.
#
# Data (DATA out of CODE):
#   voices.yaml   — personas + per-engine realizations (no fallback, no default realization)
#   engines.yaml  — engine capabilities/models/auth/format/concurrency/preconditions
# Both are parsed + VALIDATED at startup via python3 + PyYAML (fail loud).
#
# FOUR engines only: gemini | gcloud | kokoro | bark. .wrangler/ is a deployment
# target, NOT a TTS engine, and is deliberately untouched.
set -euo pipefail

VERSION="1.2.0"
CONFIG_DIR="${HOME}/.config/speak"
CONFIG_FILE="${CONFIG_DIR}/config"
SPEAK_TMPDIR=""   # set by cmd_speak; referenced by the EXIT-cleanup trap

# ── Robust symlink resolution to find SCRIPT_DIR ─────────────────────
# speak is installed as a symlink at /opt/homebrew/bin/speak -> repo/speak.
# We resolve through the readlink loop so the driver finds its sibling
# engines/, voices.yaml, and engines.yaml regardless of how it's invoked.
# (behavior #10)
_resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  local dir
  while [[ -h "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
ENGINES_DIR="${SCRIPT_DIR}/engines"
VOICES_YAML="${SCRIPT_DIR}/voices.yaml"
ENGINES_YAML="${SCRIPT_DIR}/engines.yaml"
QUEUE_DIR="${SCRIPT_DIR}/outputs"
QUEUE_FILE="${QUEUE_DIR}/queue.json"

# ── Terminal formatting ──────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
ITALIC='\033[3m'
RESET='\033[0m'
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
CYAN='\033[36m'
WHITE='\033[37m'
GRAY='\033[90m'
BG_BLACK='\033[40m'

# Disable colors if stderr is not a terminal (behavior #6c). All human-facing
# chrome targets stderr (behavior #19), so the TTY test is on fd 2.
if [[ ! -t 2 ]]; then
  BOLD="" DIM="" ITALIC="" RESET="" RED="" GREEN="" YELLOW=""
  BLUE="" MAGENTA="" CYAN="" WHITE="" GRAY="" BG_BLACK=""
fi

# ── small helpers ────────────────────────────────────────────────────
tolower() { printf "%s" "$1" | tr "[:upper:]" "[:lower:]"; }

err() { echo -e "${RED}✗ $1${RESET}" >&2; }
info() { echo -e "${DIM}$1${RESET}" >&2; }
header() { echo -e "${BOLD}${CYAN}speak${RESET} ${DIM}v${VERSION}${RESET}" >&2; }

# ── PyYAML precondition: pick an interpreter that can import yaml ─────
# Treat PyYAML as a hard precondition. Probe candidate interpreters; the
# default `python3` may be the Xcode/system one without PyYAML while a
# Homebrew/usr-local one has it. If NONE can import yaml, error loudly with
# `pip3 install pyyaml` and never silently degrade.
PYTHON=""
_resolve_python() {
  local candidates=()
  # Honor an explicit override first.
  [[ -n "${SPEAK_PYTHON:-}" ]] && candidates+=("$SPEAK_PYTHON")
  # Whatever `python3` resolves to on PATH.
  if command -v python3 >/dev/null 2>&1; then
    candidates+=("$(command -v python3)")
  fi
  # Common alternative install locations.
  candidates+=(
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3
    /opt/homebrew/bin/python3
    /usr/local/bin/python3
    /usr/bin/python3
  )
  local c
  for c in "${candidates[@]}"; do
    [[ -x "$c" ]] || continue
    if "$c" -c 'import yaml' >/dev/null 2>&1; then
      PYTHON="$c"
      return 0
    fi
  done
  return 1
}

_resolve_web_python() {
  local candidates=("$PYTHON")
  [[ -n "${SPEAK_PYTHON:-}" ]] && candidates+=("$SPEAK_PYTHON")
  if command -v python3 >/dev/null 2>&1; then
    candidates+=("$(command -v python3)")
  fi
  candidates+=(
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3
    /usr/local/bin/python3
    /opt/homebrew/bin/python3
    /usr/bin/python3
  )
  local c
  for c in "${candidates[@]}"; do
    [[ -x "$c" ]] || continue
    if "$c" -c 'import yaml, fastapi, uvicorn' >/dev/null 2>&1; then
      printf '%s' "$c"
      return 0
    fi
  done
  return 1
}
if ! _resolve_python; then
  err "PyYAML is required but not importable by any available python3."
  echo -e "${DIM}voices.yaml / engines.yaml are parsed with python3 + PyYAML.${RESET}" >&2
  echo -e "${DIM}Install it:  pip3 install pyyaml${RESET}" >&2
  echo -e "${DIM}(or set SPEAK_PYTHON=/path/to/python3 that already has it)${RESET}" >&2
  exit 1
fi

# JSON-escape a string into a JSON string literal (used for API payloads &
# building --json output). Uses the resolved interpreter (json is stdlib).
json_escape() {
  printf '%s' "$1" | "$PYTHON" -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
}

# ── YAML data access (single source of truth: the two yaml files) ─────
# A tiny query helper. We keep the heavy validation in validate_data() and
# use yq-style lookups elsewhere. All YAML parsing goes through $PYTHON.
yaml_query() {
  # $1 = yaml file, rest = python expression operating on `d` (the loaded dict)
  local file="$1"; shift
  "$PYTHON" - "$file" "$*" <<'PYEOF'
import sys, yaml
file = sys.argv[1]
expr = sys.argv[2]
with open(file) as fh:
    d = yaml.safe_load(fh)
val = eval(expr, {"d": d})
if val is None:
    pass
elif isinstance(val, (list, tuple)):
    print("\n".join(str(x) for x in val))
else:
    print(val)
PYEOF
}

# ── Startup validation gate (fail loud, exit nonzero) ────────────────
# Validates BOTH yaml files against the target.v2 schema invariants. Any
# unknown engine/persona/capability/blend-voice/model, or any structural
# violation, errors and exits nonzero. The driver MUST NOT contain a
# "default realization" or "nearest-voice" path; this gate is what keeps the
# data honest. (key-design-move: DATA out of CODE with a fail-loud gate)
validate_data() {
  local report
  if ! report="$("$PYTHON" - "$VOICES_YAML" "$ENGINES_YAML" <<'PYEOF'
import sys, yaml

voices_path, engines_path = sys.argv[1], sys.argv[2]
errors = []

def load(path, label):
    try:
        with open(path) as fh:
            return yaml.safe_load(fh)
    except FileNotFoundError:
        errors.append(f"{label} not found at {path}")
    except yaml.YAMLError as e:
        errors.append(f"{label} is not valid YAML: {e}")
    return None

engines = load(engines_path, "engines.yaml")
voices = load(voices_path, "voices.yaml")
if errors:
    print("\n".join(errors)); sys.exit(2)

VALID_ENGINES = {"gemini", "gcloud", "kokoro", "bark"}
VALID_FORMATS = {"pcm-s16le-24k-mono", "linear16", "wav"}
VALID_BILLING = {"tokens", "characters", "none"}

# ---- engines.yaml ----
if not isinstance(engines, dict):
    errors.append("engines.yaml: top-level must be a mapping")
else:
    opt = engines.get("optimizer")
    if not isinstance(opt, dict):
        errors.append("engines.yaml: missing top-level `optimizer` section")
    else:
        for k in ("model", "auth", "provides_capability"):
            if k not in opt:
                errors.append(f"engines.yaml: optimizer missing `{k}`")
        if opt.get("provides_capability") != "audio-tags":
            errors.append("engines.yaml: optimizer.provides_capability must be `audio-tags`")
        provs = opt.get("providers")
        if provs is not None and not isinstance(provs, dict):
            errors.append("engines.yaml: optimizer.providers must be a mapping")

    eng = engines.get("engines")
    if not isinstance(eng, dict):
        errors.append("engines.yaml: missing `engines` mapping")
    else:
        keys = set(eng.keys())
        if keys != VALID_ENGINES:
            errors.append(f"engines.yaml: engines must be exactly {sorted(VALID_ENGINES)}, got {sorted(keys)}")
        for name, e in eng.items():
            if not isinstance(e, dict):
                errors.append(f"engines.yaml: engine `{name}` must be a mapping"); continue
            for f in ("label","deployment","auth","capabilities","default_model","models",
                      "output_format","needs_transcode","billing_unit","max_in_flight",
                      "default_persona","preconditions"):
                if f not in e:
                    errors.append(f"engines.yaml: engine `{name}` missing field `{f}`")
            # `endpoint` is load-bearing for cloud engines (read at optimize/synth
            # time); offline engines (kokoro) legitimately have none.
            if e.get("deployment") == "cloud-api" and not e.get("endpoint"):
                errors.append(f"engines.yaml: cloud engine `{name}` missing `endpoint`")
            caps = e.get("capabilities")
            if not isinstance(caps, list):
                errors.append(f"engines.yaml: engine `{name}`.capabilities must be a list")
            else:
                for c in caps:
                    if c != "audio-tags":
                        errors.append(f"engines.yaml: engine `{name}` has unknown capability `{c}`")
            if e.get("output_format") not in VALID_FORMATS:
                errors.append(f"engines.yaml: engine `{name}`.output_format `{e.get('output_format')}` not in {sorted(VALID_FORMATS)}")
            if e.get("billing_unit") not in VALID_BILLING:
                errors.append(f"engines.yaml: engine `{name}`.billing_unit `{e.get('billing_unit')}` not in {sorted(VALID_BILLING)}")
            mif = e.get("max_in_flight")
            if not isinstance(mif, int) or mif < 1:
                errors.append(f"engines.yaml: engine `{name}`.max_in_flight must be int >= 1")
            models = e.get("models")
            if not isinstance(models, dict):
                errors.append(f"engines.yaml: engine `{name}`.models must be a mapping")
            elif e.get("default_model") not in models:
                errors.append(f"engines.yaml: engine `{name}`.default_model `{e.get('default_model')}` not a key of models")
            dp = e.get("default_persona")
            # cross-checked against personas below
            e["_default_persona"] = dp

# kokoro native_voices sanity (locale lookup data, not bf_/bm_ prefix)
kokoro = (engines or {}).get("engines", {}).get("kokoro", {}) if isinstance(engines, dict) else {}
native = kokoro.get("native_voices", {}) if isinstance(kokoro, dict) else {}
if not isinstance(native, dict) or not native:
    errors.append("engines.yaml: kokoro.native_voices must be a non-empty mapping")

# ---- voices.yaml ----
persona_ids = set()
if not isinstance(voices, dict):
    errors.append("voices.yaml: top-level must be a mapping")
else:
    dp = voices.get("default_persona")
    personas = voices.get("personas")
    if not isinstance(personas, dict) or not personas:
        errors.append("voices.yaml: missing `personas` mapping")
    else:
        persona_ids = set(personas.keys())
        if dp not in persona_ids:
            errors.append(f"voices.yaml: default_persona `{dp}` is not a defined persona")
        default_flagged = [pid for pid,p in personas.items() if isinstance(p,dict) and p.get("default")]
        if len(default_flagged) > 1:
            errors.append(f"voices.yaml: more than one persona marked default: {default_flagged}")
        for pid, p in personas.items():
            if pid != pid.lower():
                errors.append(f"voices.yaml: persona id `{pid}` must be lowercase")
            if not isinstance(p, dict):
                errors.append(f"voices.yaml: persona `{pid}` must be a mapping"); continue
            for f in ("style","glyph","color"):
                if f not in p:
                    errors.append(f"voices.yaml: persona `{pid}` missing `{f}`")
            reals = p.get("realizations")
            if not isinstance(reals, dict) or not reals:
                errors.append(f"voices.yaml: persona `{pid}` has no realizations")
                continue
            for ek, r in reals.items():
                if ek not in VALID_ENGINES:
                    errors.append(f"voices.yaml: persona `{pid}` realization names unknown engine `{ek}`")
                    continue
                if not isinstance(r, dict):
                    errors.append(f"voices.yaml: persona `{pid}`.{ek} must be a mapping"); continue
                has_voice = "voice" in r
                has_blend = "blend" in r
                if ek == "kokoro":
                    if has_voice == has_blend:
                        errors.append(f"voices.yaml: persona `{pid}`.kokoro must have EXACTLY one of voice|blend")
                    if has_blend:
                        blend = r["blend"]
                        if not isinstance(blend, list) or not blend:
                            errors.append(f"voices.yaml: persona `{pid}`.kokoro.blend must be a non-empty list")
                        else:
                            for comp in blend:
                                if not isinstance(comp, dict) or "voice" not in comp or "weight" not in comp:
                                    errors.append(f"voices.yaml: persona `{pid}`.kokoro.blend component needs voice+weight")
                                elif native and comp["voice"] not in native:
                                    errors.append(f"voices.yaml: persona `{pid}`.kokoro.blend voice `{comp['voice']}` not in engines.yaml native_voices")
                    elif has_voice and native and r["voice"] not in native:
                        errors.append(f"voices.yaml: persona `{pid}`.kokoro.voice `{r['voice']}` not in engines.yaml native_voices")
                else:
                    if not has_voice:
                        errors.append(f"voices.yaml: persona `{pid}`.{ek} missing `voice`")

# cross-check each engine.default_persona realizes itself (coverage invariant)
if isinstance(engines, dict) and persona_ids:
    for name, e in engines.get("engines", {}).items():
        dp = e.get("_default_persona") if isinstance(e, dict) else None
        if dp is None:
            continue
        p = (voices or {}).get("personas", {}).get(dp)
        if not isinstance(p, dict):
            errors.append(f"coverage: engine `{name}` default_persona `{dp}` is not a defined persona")
        elif name not in (p.get("realizations") or {}):
            errors.append(f"coverage: engine `{name}` default_persona `{dp}` has no `{name}` realization")

if errors:
    print("\n".join(errors)); sys.exit(2)
PYEOF
)"; then
    err "Data validation failed:"
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      echo -e "  ${DIM}${line}${RESET}" >&2
    done <<< "$report"
    echo -e "${DIM}Fix voices.yaml / engines.yaml and retry.${RESET}" >&2
    exit 1
  fi
}

# ── Config management ────────────────────────────────────────────────
# New schema keys: engine, persona, model_overrides.<engine>, optimizer_provider, optimizer_model.
# Comment-tolerant key=value reader (behavior #13a). Defaults sourced from data.
load_config() {
  CFG_ENGINE=""
  CFG_PERSONA=""
  CFG_OPTIMIZER_PROVIDER=""
  CFG_OPTIMIZER_MODEL=""
  CFG_DAEMON_PROMPT=""
  CFG_EMPHASIS=""
  CFG_VIEW=""
  # Per-engine model overrides stored as model_overrides.<engine>=<model>.
  # Kept as plain scalars (bash 3.2-compatible; no associative arrays) since
  # there are exactly four known engines.
  CFG_MODEL_OVERRIDE_gemini=""
  CFG_MODEL_OVERRIDE_gcloud=""
  CFG_MODEL_OVERRIDE_kokoro=""
  CFG_MODEL_OVERRIDE_bark=""
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS='=' read -r key value; do
      [[ -z "$key" || "$key" == \#* ]] && continue
      key=$(echo "$key" | xargs)
      value=$(echo "$value" | xargs)
      case "$key" in
        engine) CFG_ENGINE="$value" ;;
        persona) CFG_PERSONA="$value" ;;
        optimizer_provider) CFG_OPTIMIZER_PROVIDER="$value" ;;
        optimizer_model) CFG_OPTIMIZER_MODEL="$value" ;;
        daemon_prompt|prompt_daemon) CFG_DAEMON_PROMPT="$value" ;;
        emphasis) CFG_EMPHASIS="$value" ;;
        view) CFG_VIEW="$value" ;;
        model_overrides.gemini) CFG_MODEL_OVERRIDE_gemini="$value" ;;
        model_overrides.gcloud) CFG_MODEL_OVERRIDE_gcloud="$value" ;;
        model_overrides.kokoro) CFG_MODEL_OVERRIDE_kokoro="$value" ;;
        model_overrides.bark) CFG_MODEL_OVERRIDE_bark="$value" ;;
      esac
    done < "$CONFIG_FILE"
  fi
  # Defaults pulled from the validated data files.
  DATA_DEFAULT_PERSONA="$(yaml_query "$VOICES_YAML" 'd.get("default_persona","puck")')"
  OPTIMIZER_DEFAULT_PROVIDER="$(yaml_query "$ENGINES_YAML" 'd.get("optimizer",{}).get("default_provider","gemini")')"
  OPTIMIZER_PROVIDER="${CFG_OPTIMIZER_PROVIDER:-$OPTIMIZER_DEFAULT_PROVIDER}"

  OPTIMIZER_MODEL="$(yaml_query "$ENGINES_YAML" 'd["optimizer"]["model"]')"
  if [[ -n "$CFG_OPTIMIZER_MODEL" ]]; then
    OPTIMIZER_MODEL="$CFG_OPTIMIZER_MODEL"
  elif [[ "$OPTIMIZER_PROVIDER" == "openrouter" ]]; then
    local or_def; or_def="$(yaml_query "$ENGINES_YAML" 'd.get("optimizer",{}).get("providers",{}).get("openrouter",{}).get("default_model","openrouter/free")')"
    [[ -n "$or_def" ]] && OPTIMIZER_MODEL="$or_def"
  fi

  # Auto-detection: if model slug contains "/" and provider was not explicitly configured, infer openrouter
  if [[ -z "$CFG_OPTIMIZER_PROVIDER" && "$OPTIMIZER_MODEL" == *"/"* ]]; then
    OPTIMIZER_PROVIDER="openrouter"
  fi
  return 0
}

# Portable in-place key=value upsert (behavior #13b). Replaces BSD-only
# `sed -i ''`, which is NOT GNU-compatible (latent Pop!_OS/lumen bug). We use
# a python rewrite-to-temp-then-mv via the resolved interpreter — works
# identically on macOS and Linux.
save_config_value() {
  mkdir -p "$CONFIG_DIR"
  local key="$1" value="$2"
  "$PYTHON" - "$CONFIG_FILE" "$key" "$value" <<'PYEOF'
import sys, os, tempfile
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
lines = []
if os.path.exists(path):
    with open(path) as fh:
        lines = fh.read().splitlines()
out = []
found = False
for line in lines:
    stripped = line.strip()
    if stripped and not stripped.startswith("#") and "=" in line:
        k = line.split("=", 1)[0].strip()
        if k == key:
            out.append(f"{key}={value}")
            found = True
            continue
    out.append(line)
if not found:
    out.append(f"{key}={value}")
d = os.path.dirname(path) or "."
os.makedirs(d, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=d)
with os.fdopen(fd, "w") as fh:
    fh.write("\n".join(out) + "\n")
os.replace(tmp, path)
PYEOF
}

# Delete a config key (used when migration replaces a legacy key).
delete_config_value() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  local key="$1"
  "$PYTHON" - "$CONFIG_FILE" "$key" <<'PYEOF'
import sys, os, tempfile
path, key = sys.argv[1], sys.argv[2]
if not os.path.exists(path):
    sys.exit(0)
with open(path) as fh:
    lines = fh.read().splitlines()
out = []
for line in lines:
    stripped = line.strip()
    if stripped and not stripped.startswith("#") and "=" in line:
        k = line.split("=", 1)[0].strip()
        if k == key:
            continue
    out.append(line)
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d)
with os.fdopen(fd, "w") as fh:
    fh.write("\n".join(out) + ("\n" if out else ""))
os.replace(tmp, path)
PYEOF
}

# ── Config migration (runs once; errors on unmappable value) ─────────
# old → new:
#   use_gcloud=true | use_cloud=true   → engine: gcloud
#   use_gcloud=false| use_cloud=false  → engine: gemini
#   voice=Puck                         → persona: puck (lowercase; FAIL if unknown)
#   tts_model=X                        → model_overrides.gemini=X
#   optimize_model=X                   → optimizer_model: X
# (We accept legacy `use_cloud` too — a real on-disk config still carries it.)
migrate_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  # Quick scan: do any legacy keys exist?
  local has_legacy=false
  while IFS='=' read -r k _; do
    k=$(echo "$k" | xargs)
    case "$k" in
      voice|tts_model|optimize_model|use_gcloud|use_cloud) has_legacy=true ;;
    esac
  done < "$CONFIG_FILE"
  [[ "$has_legacy" == false ]] && return 0

  info "migrating ~/.config/speak/config to the new schema…"

  # Read raw legacy values.
  local L_VOICE="" L_TTS_MODEL="" L_OPTIMIZE_MODEL="" L_GCLOUD=""
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    key=$(echo "$key" | xargs); value=$(echo "$value" | xargs)
    case "$key" in
      voice) L_VOICE="$value" ;;
      tts_model) L_TTS_MODEL="$value" ;;
      optimize_model) L_OPTIMIZE_MODEL="$value" ;;
      use_gcloud|use_cloud) L_GCLOUD="$value" ;;
    esac
  done < "$CONFIG_FILE"

  # use_gcloud/use_cloud → engine (error on unmappable)
  if [[ -n "$L_GCLOUD" ]]; then
    case "$(tolower "$L_GCLOUD")" in
      true)  save_config_value "engine" "gcloud" ;;
      false) save_config_value "engine" "gemini" ;;
      *) err "config migration: cannot map use_gcloud='${L_GCLOUD}' (expected true|false)"; exit 1 ;;
    esac
    delete_config_value "use_gcloud"
    delete_config_value "use_cloud"
  fi

  # voice=Puck → persona: puck (lowercase-normalize; FAIL if no matching persona)
  if [[ -n "$L_VOICE" ]]; then
    local pid; pid="$(tolower "$L_VOICE")"
    if [[ "$(persona_exists "$pid"; echo $?)" != "0" ]]; then
      err "config migration: voice='${L_VOICE}' has no matching persona in voices.yaml"
      exit 1
    fi
    save_config_value "persona" "$pid"
    delete_config_value "voice"
  fi

  # tts_model=X → model_overrides.gemini=X (the legacy tts_model was Gemini's)
  if [[ -n "$L_TTS_MODEL" ]]; then
    save_config_value "model_overrides.gemini" "$L_TTS_MODEL"
    delete_config_value "tts_model"
  fi

  # optimize_model=X → optimizer_model: X
  if [[ -n "$L_OPTIMIZE_MODEL" ]]; then
    save_config_value "optimizer_model" "$L_OPTIMIZE_MODEL"
    delete_config_value "optimize_model"
  fi

  info "migration complete."
  # Reload so the rest of the run sees the migrated values.
  load_config
}

# ── Persona / engine resolution ──────────────────────────────────────
# Returns 0 if a persona id (already lowercased) exists.
persona_exists() {
  local pid="$1"
  local hit
  hit="$(yaml_query "$VOICES_YAML" "1 if '${pid}' in (d.get('personas') or {}) else 0")"
  [[ "$hit" == "1" ]]
}

# Canonical persona id from any-case input. Echoes lowercase id, returns 0 if
# it exists, else returns 1. (behavior #14 — case-insensitive lookup.)
canonical_persona() {
  local want; want="$(tolower "$1")"
  if persona_exists "$want"; then
    printf '%s' "$want"
    return 0
  fi
  # Allow raw Kokoro prefix lookup (e.g. af_bella -> bella, am_adam -> adam)
  local stripped="$want"
  for pfx in af_ am_ bf_ bm_ ef_ em_ ff_ hf_ hm_ if_ im_ jf_ jm_ pf_ pm_ zf_ zm_; do
    if [[ "$want" == "$pfx"* ]]; then
      stripped="${want#"$pfx"}"
      if persona_exists "$stripped"; then
        printf '%s' "$stripped"
        return 0
      fi
    fi
  done
  return 1
}

# Validate an engine id.
engine_exists() {
  local e="$1"
  case "$e" in gemini|gcloud|kokoro|bark) return 0 ;; *) return 1 ;; esac
}

# Engines that DO realize a given persona (space-separated). For the
# hard-error message and the coverage grid.
engines_realizing() {
  local pid="$1"
  yaml_query "$VOICES_YAML" "sorted((d['personas']['${pid}'].get('realizations') or {}).keys())"
}

# Does <engine> realize <persona>?
has_realization() {
  local pid="$1" engine="$2"
  local hit
  hit="$(yaml_query "$VOICES_YAML" "1 if '${engine}' in (d['personas']['${pid}'].get('realizations') or {}) else 0")"
  [[ "$hit" == "1" ]]
}

# Persona display fields: style|glyph|color
persona_fields() {
  local pid="$1"
  yaml_query "$VOICES_YAML" "'%s|%s|%s' % (d['personas']['${pid}'].get('style',''), d['personas']['${pid}'].get('glyph','?'), d['personas']['${pid}'].get('color','37'))"
}

# Resolve (persona, engine) → a realization spec the adapter understands.
# Echoes (one per line):
#   line 1: REALIZATION   (gemini: voice name; gcloud: full Chirp3 name;
#                          kokoro: voice id OR blend spec "v:w,v:w")
#   line 2: LANGUAGE_CODE (may be empty)
#   line 3: BADGE_NAME    (human label of what was ACTUALLY rendered)
# HARD ERROR (no fallback) is enforced by the caller via has_realization.
# (sc:resolve-voice; key-design-move PERSONA/REALIZATION split.)
resolve_realization() {
  local pid="$1" engine="$2"
  "$PYTHON" - "$VOICES_YAML" "$ENGINES_YAML" "$pid" "$engine" <<'PYEOF'
import sys, yaml
vpath, epath, pid, engine = sys.argv[1:5]
with open(vpath) as fh: voices = yaml.safe_load(fh)
with open(epath) as fh: engines = yaml.safe_load(fh)
r = voices["personas"][pid]["realizations"][engine]
native = (engines["engines"].get("kokoro") or {}).get("native_voices", {})

realization = ""
lang = ""
badge = ""

if engine == "kokoro":
    if "blend" in r:
        comps = r["blend"]
        pairs = []
        # locale from the FIRST component's native_voices entry (all components
        # of a blend share a locale family in our data); never inferred from
        # the bf_/bm_ string prefix.
        first = comps[0]["voice"]
        lang = (native.get(first, {}) or {}).get("language_code", "en-us")
        for c in comps:
            pairs.append("%s:%s" % (c["voice"], c["weight"]))
        realization = ",".join(pairs)
        names = "+".join(c["voice"] for c in comps)
        badge = "%s blend" % names
    else:
        v = r["voice"]
        realization = v
        lang = (native.get(v, {}) or {}).get("language_code", "en-us")
        badge = v
else:
    realization = r["voice"]
    lang = r.get("language_code", "")
    badge = r["voice"]

print(realization)
print(lang)
print(badge)
PYEOF
}

# Engine-level fields from engines.yaml.
engine_field() {
  local engine="$1" field="$2"
  yaml_query "$ENGINES_YAML" "(d['engines']['${engine}'].get('${field}'))"
}

engine_has_audio_tags() {
  local engine="$1"
  local hit
  hit="$(yaml_query "$ENGINES_YAML" "1 if 'audio-tags' in (d['engines']['${engine}'].get('capabilities') or []) else 0")"
  [[ "$hit" == "1" ]]
}

# Resolve a model: --model flag (key or literal) > model_overrides[engine] >
# engines.yaml models.default. A flag value that matches a models.<key>
# resolves to that key's id; otherwise it's treated as a literal id.
# Echoes the concrete model id (may be empty string for engines like gcloud
# whose models.default is null).
# Read the per-engine model override scalar (bash 3.2 indirection).
model_override_for() {
  local engine="$1" var="CFG_MODEL_OVERRIDE_$1"
  printf '%s' "${!var:-}"
}

resolve_model() {
  local engine="$1" flag="${2:-}"
  local override; override="$(model_override_for "$engine")"
  "$PYTHON" - "$ENGINES_YAML" "$engine" "$flag" "$override" <<'PYEOF'
import sys, yaml
epath, engine, flag, override = sys.argv[1:5]
with open(epath) as fh: engines = yaml.safe_load(fh)
e = engines["engines"][engine]
models = e.get("models") or {}
default_key = e.get("default_model")

def emit(v):
    print("" if v is None else v)

if flag:
    # key match first, else literal id
    if flag in models:
        emit(models[flag])
    else:
        emit(flag)
elif override:
    emit(override)
else:
    emit(models.get(default_key))
PYEOF
}

# ── Voice/persona badge (names the REALIZATION actually rendered) ────
# behavior #6: per-persona color+glyph identity; badge must show what was
# actually rendered (kills the lying-badge bug, behavior #6 CRITICAL). We
# print the persona glyph+name, and when the rendered realization differs
# (e.g. kokoro blend, or gcloud's prefixed name), append it; when identical
# (gemini Puck == persona Puck), collapse.
print_persona_badge() {
  local pid="$1" badge_name="${2:-}"
  local fields style glyph color
  fields="$(persona_fields "$pid")"
  IFS='|' read -r style glyph color <<< "$fields"
  # Persona display name = canonical-cap of the persona id (Title Case the id).
  local pname; pname="$(printf '%s' "$pid" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  printf "\033[${color}m${glyph} ${pname}\033[0m"
  # Collapse when the realization name equals the persona name (case-insensitive).
  if [[ -n "$badge_name" && "$(tolower "$badge_name")" != "$(tolower "$pname")" ]]; then
    printf " ${DIM}→ ${badge_name}${RESET}"
  fi
}

# ── Subcommands ──────────────────────────────────────────────────────
# `speak voices` — personas for the ACTIVE engine, marking realization;
# unrealized shown dimmed with reason. `--all` = persona×engine coverage grid.
cmd_voices() {
  local show_all=false
  [[ "${1:-}" == "--all" ]] && show_all=true

  local active_engine="$ENGINE"
  header
  echo "" >&2

  # default persona for the active-engine view
  local default_persona="$DATA_DEFAULT_PERSONA"
  [[ -n "$CFG_PERSONA" ]] && default_persona="$CFG_PERSONA"

  if [[ "$show_all" == true ]]; then
    echo -e "${BOLD}Persona × engine coverage${RESET}  ${DIM}(✓ realized · · unavailable)${RESET}" >&2
    echo -e "${DIM}───────────────────────────────────────────────────────${RESET}" >&2
    printf "  %-16s ${DIM}%-8s %-8s %-8s %-8s${RESET}\n" "persona" "gemini" "gcloud" "kokoro" "bark" >&2
    # iterate personas in file order
    local pid
    while IFS= read -r pid; do
      [[ -z "$pid" ]] && continue
      local fields style glyph color
      fields="$(persona_fields "$pid")"
      IFS='|' read -r style glyph color <<< "$fields"
      local g c k b
      g="·"; c="·"; k="·"; b="·"
      has_realization "$pid" gemini && g="✓"
      has_realization "$pid" gcloud && c="✓"
      has_realization "$pid" kokoro && k="✓"
      has_realization "$pid" bark && b="✓"
      printf "  \033[${color}m${glyph} %-14s\033[0m %-8s %-8s %-8s %-8s\n" "$pid" "$g" "$c" "$k" "$b" >&2
    done < <(yaml_query "$VOICES_YAML" "list(d['personas'].keys())")
    echo "" >&2
    echo -e "${DIM}Active engine: ${active_engine}. Realizations are declared in voices.yaml.${RESET}" >&2
    return
  fi

  local elabel; elabel="$(engine_field "$active_engine" label)"
  echo -e "${BOLD}Personas for ${elabel}${RESET} ${DIM}(engine: ${active_engine})${RESET}" >&2
  echo -e "${DIM}──────────────────────────────────${RESET}" >&2
  local pid
  while IFS= read -r pid; do
    [[ -z "$pid" ]] && continue
    local fields style glyph color
    fields="$(persona_fields "$pid")"
    IFS='|' read -r style glyph color <<< "$fields"
    local marker=""
    if [[ "$(tolower "$pid")" == "$(tolower "$default_persona")" ]]; then
      marker=" ${GREEN}← default${RESET}"
    fi
    if has_realization "$pid" "$active_engine"; then
      printf "  \033[${color}m${glyph}  %-16s\033[0m ${DIM}%s${RESET}%b\n" "$pid" "$style" "$marker" >&2
    else
      # unrealized in active engine: dim it and name a reason
      local realizers; realizers="$(engines_realizing "$pid" | tr '\n' ' ')"
      printf "  ${DIM}%s  %-16s  (no ${active_engine} realization — try: %s)${RESET}\n" "$glyph" "$pid" "$realizers" >&2
    fi
  done < <(yaml_query "$VOICES_YAML" "list(d['personas'].keys())")
  echo "" >&2
  echo -e "${DIM}Coverage grid: speak voices --all   ·   Set default: speak set persona <name>${RESET}" >&2
}

# `speak set engine|persona|model …` mirrors config. No-arg shows config.
cmd_set() {
  if [[ $# -lt 1 ]]; then
    # show current config with a persona badge
    header
    echo "" >&2
    echo -e "${BOLD}Current config${RESET} ${DIM}(${CONFIG_FILE})${RESET}" >&2
    echo -e "${DIM}──────────────────────────────────${RESET}" >&2
    echo -e "  engine          ${DIM}${ENGINE}${RESET}" >&2
    local persona; persona="$DATA_DEFAULT_PERSONA"; [[ -n "$CFG_PERSONA" ]] && persona="$CFG_PERSONA"
    echo -ne "  persona         " >&2
    local rname rlang rbadge
    if has_realization "$persona" "$ENGINE"; then
      { IFS= read -r rname; IFS= read -r rlang; IFS= read -r rbadge; } < <(resolve_realization "$persona" "$ENGINE")
      print_persona_badge "$persona" "$rbadge" >&2
    else
      print_persona_badge "$persona" "" >&2
      echo -ne "  ${DIM}(no ${ENGINE} realization)${RESET}" >&2
    fi
    echo "" >&2
    local mdl; mdl="$(resolve_model "$ENGINE" "")"
    echo -e "  model              ${DIM}${mdl:-<engine default>}${RESET}" >&2
    echo -e "  optimizer_provider ${DIM}${OPTIMIZER_PROVIDER}${RESET}" >&2
    echo -e "  optimizer_model    ${DIM}${OPTIMIZER_MODEL}${RESET}" >&2
    local dp="${CFG_DAEMON_PROMPT:-true}"
    echo -e "  daemon_prompt      ${DIM}${dp}${RESET}" >&2
    echo -e "  emphasis           ${DIM}${CFG_EMPHASIS:-bold}${RESET}" >&2
    echo -e "  view               ${DIM}${CFG_VIEW:-scroll}${RESET}" >&2
    local oe
    for oe in gemini gcloud kokoro bark; do
      local ov; ov="$(model_override_for "$oe")"
      [[ -n "$ov" ]] && echo -e "  ${DIM}override ${oe} = ${ov}${RESET}" >&2
    done
    echo "" >&2
    return
  fi

  local key="$1" value="${2:-}"
  case "$key" in
    engine)
      if [[ -z "$value" ]] || ! engine_exists "$value"; then
        err "Invalid engine: '${value:-}'. Must be one of: gemini, gcloud, kokoro, bark"
        exit 1
      fi
      save_config_value "engine" "$value"
      echo -e "${GREEN}✓${RESET} engine set to ${BOLD}${value}${RESET}" >&2
      ;;
    persona|voice)  # accept legacy alias 'voice' but operate on personas
      local pid
      if ! pid="$(canonical_persona "$value")"; then
        err "Unknown persona: ${value:-}"
        echo -e "${DIM}Run 'speak voices' to see options${RESET}" >&2
        exit 1
      fi
      save_config_value "persona" "$pid"
      echo -ne "${GREEN}✓${RESET} Default persona set to " >&2
      print_persona_badge "$pid" "" >&2
      echo "" >&2
      ;;
    model)
      # speak set model <id>           → override active engine's model
      # speak set model <engine> <id>  → override a specific engine's model
      local target_engine="$ENGINE" model_val="$value"
      if [[ $# -ge 3 ]] && engine_exists "$value"; then
        target_engine="$value"; model_val="$3"
      fi
      if [[ -z "$model_val" ]]; then
        err "Usage: speak set model <id>   |   speak set model <engine> <id>"
        exit 1
      fi
      save_config_value "model_overrides.${target_engine}" "$model_val"
      echo -e "${GREEN}✓${RESET} model_overrides.${target_engine} set to ${BOLD}${model_val}${RESET}" >&2
      ;;
    optimizer_provider)
      if [[ "$value" != "gemini" && "$value" != "openrouter" ]]; then
        err "Invalid optimizer provider: '${value:-}'. Must be one of: gemini, openrouter"
        exit 1
      fi
      save_config_value "optimizer_provider" "$value"
      echo -e "${GREEN}✓${RESET} optimizer_provider set to ${BOLD}${value}${RESET}" >&2
      ;;
    optimizer_model)
      [[ -z "$value" ]] && { err "Usage: speak set optimizer_model <model>"; exit 1; }
      save_config_value "optimizer_model" "$value"
      if [[ "$value" == *"/"* && "$OPTIMIZER_PROVIDER" != "openrouter" ]]; then
        save_config_value "optimizer_provider" "openrouter"
        echo -e "${GREEN}✓${RESET} optimizer_provider automatically updated to ${BOLD}openrouter${RESET}" >&2
      fi
      echo -e "${GREEN}✓${RESET} optimizer_model set to ${BOLD}${value}${RESET}" >&2
      ;;
    daemon_prompt|prompt_daemon)
      case "$(tolower "${value:-}")" in
        true|yes|on|1)
          save_config_value "daemon_prompt" "true"
          echo -e "${GREEN}✓${RESET} daemon_prompt set to ${BOLD}true${RESET} (will prompt after standalone runs)" >&2
          ;;
        false|no|off|0)
          save_config_value "daemon_prompt" "false"
          echo -e "${GREEN}✓${RESET} daemon_prompt set to ${BOLD}false${RESET} (prompt disabled)" >&2
          ;;
        *)
          err "Invalid value for daemon_prompt: '${value:-}'. Must be 'true' or 'false'"
          exit 1
          ;;
      esac
      ;;
    emphasis)
      case "$(tolower "${value:-}")" in
        bold|underline|both|inverse)
          save_config_value "emphasis" "$(tolower "$value")"
          echo -e "${GREEN}✓${RESET} caption emphasis set to ${BOLD}$(tolower "$value")${RESET}" >&2
          ;;
        *)
          err "Invalid emphasis: '${value:-}'. Must be one of: bold, underline, both, inverse"
          exit 1
          ;;
      esac
      ;;
    view)
      case "$(tolower "${value:-}")" in
        scroll|window)
          save_config_value "view" "$(tolower "$value")"
          echo -e "${GREEN}✓${RESET} caption view set to ${BOLD}$(tolower "$value")${RESET}" >&2
          ;;
        *)
          err "Invalid view: '${value:-}'. Must be one of: scroll, window"
          exit 1
          ;;
      esac
      ;;
    *)
      err "Unknown config key: $key"
      echo -e "${DIM}Valid keys: engine, persona, model, optimizer_provider, optimizer_model, daemon_prompt, emphasis, view${RESET}" >&2
      exit 1
      ;;
  esac
}

# ── Persistent Model Daemons (Fast Local Response) ───────────────────
daemon_pid() {
  local name="$1"
  local pid_file="${CONFIG_DIR}/${name}.pid"
  if [[ -f "$pid_file" ]]; then
    local p; p=$(cat "$pid_file" 2>/dev/null | xargs)
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then
      echo "$p"
      return 0
    fi
  fi
  return 1
}

is_daemon_running() {
  local name="$1"
  local pid; pid=$(daemon_pid "$name" || true)
  local sock="${CONFIG_DIR}/${name}.sock"
  [[ -n "$pid" && -S "$sock" ]]
}

daemon_status_one() {
  local name="$1" label="$2"
  local pid; pid=$(daemon_pid "$name" || true)
  local sock="${CONFIG_DIR}/${name}.sock"
  if [[ -n "$pid" && -S "$sock" ]]; then
    local mem
    mem=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.1f MB", $1/1024}' || echo "")
    echo -e "  ${BOLD}${label}${RESET}  ${GREEN}● running${RESET}  ${DIM}(pid: ${pid}${mem:+, mem: ${mem}})${RESET}" >&2
  elif [[ -n "$pid" ]]; then
    echo -e "  ${BOLD}${label}${RESET}  ${YELLOW}▲ starting / busy${RESET}  ${DIM}(pid: ${pid})${RESET}" >&2
  else
    echo -e "  ${BOLD}${label}${RESET}  ${DIM}○ stopped${RESET}" >&2
  fi
}

daemon_start_one() {
  local name="$1" label="$2" script="$3"
  mkdir -p "$CONFIG_DIR"
  local pid; pid=$(daemon_pid "$name" || true)
  if [[ -n "$pid" ]]; then
    echo -e "  ${label} is already running ${DIM}(pid: ${pid})${RESET}" >&2
    return 0
  fi
  echo -ne "  Starting ${BOLD}${label}${RESET} in background... " >&2
  local log_file="${CONFIG_DIR}/${name}_daemon.log"
  nohup "$PYTHON" "$script" > "$log_file" 2>&1 &
  local new_pid=$!
  disown "$new_pid" 2>/dev/null || true
  # Wait up to 15s for socket
  local sock="${CONFIG_DIR}/${name}.sock"
  local waited=0
  while [[ $waited -lt 15 ]]; do
    if [[ -S "$sock" ]]; then
      echo -e "${GREEN}✓ done${RESET} ${DIM}(pid: ${new_pid})${RESET}" >&2
      return 0
    fi
    if ! kill -0 "$new_pid" 2>/dev/null; then
      echo -e "${RED}✗ failed${RESET}" >&2
      cat "$log_file" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  if [[ -S "$sock" ]]; then
    echo -e "${GREEN}✓ done${RESET} ${DIM}(pid: ${new_pid})${RESET}" >&2
  else
    echo -e "${YELLOW}started in background${RESET} ${DIM}(initializing... check 'speak daemon status')${RESET}" >&2
  fi
}

daemon_stop_one() {
  local name="$1" label="$2"
  local pid_file="${CONFIG_DIR}/${name}.pid"
  local sock_file="${CONFIG_DIR}/${name}.sock"
  local pid; pid=$(daemon_pid "$name" || true)
  if [[ -z "$pid" ]]; then
    rm -f "$pid_file" "$sock_file" 2>/dev/null
    echo -e "  ${label} is not running." >&2
    return 0
  fi
  echo -ne "  Stopping ${label} (pid ${pid})... " >&2
  kill -15 "$pid" 2>/dev/null || true
  local waited=0
  while kill -0 "$pid" 2>/dev/null && [[ $waited -lt 5 ]]; do
    sleep 0.5
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file" "$sock_file" 2>/dev/null
  echo -e "${GREEN}✓ stopped${RESET}" >&2
}

# ── Persistent Web UI Sidecar Server (`speak web`) ───────────────────
WEB_DEFAULT_HOST="127.0.0.1"
WEB_DEFAULT_PORT="2420"
WEB_LAUNCHD_LABEL="com.speak.webui"
WEB_LAUNCHD_PLIST="${HOME}/Library/LaunchAgents/${WEB_LAUNCHD_LABEL}.plist"

web_pid() {
  local port="${1:-$WEB_DEFAULT_PORT}"
  local pid_file="${CONFIG_DIR}/web.pid"
  if [[ -f "$pid_file" ]]; then
    local p; p=$(cat "$pid_file" 2>/dev/null | xargs)
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then
      echo "$p"
      return 0
    fi
  fi
  if command -v lsof >/dev/null 2>&1; then
    local lp; lp=$(lsof -t -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | head -n 1 || true)
    if [[ -n "$lp" ]] && kill -0 "$lp" 2>/dev/null; then
      echo "$lp"
      return 0
    fi
  fi
  local pp; pp=$(pgrep -f "${SCRIPT_DIR}/web_ui.py" 2>/dev/null | head -n 1 || true)
  if [[ -n "$pp" ]] && kill -0 "$pp" 2>/dev/null; then
    echo "$pp"
    return 0
  fi
  return 1
}

web_keepalive_mode() {
  local sup_pid_file="${CONFIG_DIR}/web_supervisor.pid"
  if [[ -f "$sup_pid_file" ]]; then
    local sp; sp=$(cat "$sup_pid_file" 2>/dev/null | xargs)
    if [[ -n "$sp" ]] && kill -0 "$sp" 2>/dev/null; then
      if [[ -f "$WEB_LAUNCHD_PLIST" ]]; then
        echo "supervisor + launchd"
      else
        echo "supervisor"
      fi
      return 0
    fi
  fi
  if [[ "$(uname -s)" == "Darwin" ]] && [[ -f "$WEB_LAUNCHD_PLIST" ]]; then
    if launchctl list "$WEB_LAUNCHD_LABEL" >/dev/null 2>&1; then
      echo "launchd"
      return 0
    fi
  fi
  echo "standalone"
}

web_status_one() {
  local host="${1:-$WEB_DEFAULT_HOST}" port="${2:-$WEB_DEFAULT_PORT}"
  local pid; pid=$(web_pid "$port" || true)
  local url="http://${host}:${port}"
  if [[ -n "$pid" ]]; then
    local mem mode
    mem=$(ps -o rss= -p "$pid" 2>/dev/null | awk '{printf "%.1f MB", $1/1024}' || echo "")
    mode=$(web_keepalive_mode)
    echo -e "  ${BOLD}Web UI Server${RESET}  ${GREEN}● running${RESET}  ${CYAN}${url}${RESET}  ${DIM}(pid: ${pid}${mem:+, mem: ${mem}}, keepalive: ${mode})${RESET}" >&2
  else
    echo -e "  ${BOLD}Web UI Server${RESET}  ${DIM}○ stopped${RESET}  ${DIM}(${url})${RESET}" >&2
  fi
}

web_write_launchagent() {
  local web_py="$1" host="$2" port="$3" log_file="$4"
  mkdir -p "${HOME}/Library/LaunchAgents"
  cat > "$WEB_LAUNCHD_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${WEB_LAUNCHD_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${web_py}</string>
    <string>${SCRIPT_DIR}/web_ui.py</string>
    <string>--host</string>
    <string>${host}</string>
    <string>--port</string>
    <string>${port}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>${SCRIPT_DIR}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardOutPath</key>
  <string>${log_file}</string>
  <key>StandardErrorPath</key>
  <string>${log_file}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin</string>
    <key>HOME</key>
    <string>${HOME}</string>
  </dict>
</dict>
</plist>
PLIST
}

web_start_one() {
  local host="${1:-$WEB_DEFAULT_HOST}" port="${2:-$WEB_DEFAULT_PORT}"
  mkdir -p "$CONFIG_DIR"
  local web_py
  if ! web_py="$(_resolve_web_python)"; then
    err "Web UI requires python3 with fastapi, uvicorn, and pyyaml."
    echo -e "${DIM}Install with: pip3 install fastapi uvicorn pyyaml${RESET}" >&2
    return 1
  fi

  local existing_pid; existing_pid=$(web_pid "$port" || true)
  local current_mode; current_mode=$(web_keepalive_mode)
  if [[ -n "$existing_pid" && "$current_mode" != "standalone" ]]; then
    echo -e "  Web UI Server is already running at ${CYAN}http://${host}:${port}${RESET} ${DIM}(pid: ${existing_pid}, keepalive: ${current_mode})${RESET}" >&2
    return 0
  fi

  # If running standalone without keepalive, stop it first so the keepalive supervisor owns it cleanly.
  if [[ -n "$existing_pid" ]]; then
    kill -15 "$existing_pid" 2>/dev/null || true
    sleep 0.5
  fi

  local log_file="${CONFIG_DIR}/web_ui.log"
  echo -ne "  Starting ${BOLD}Web UI Server${RESET} (keepalive) on ${CYAN}http://${host}:${port}${RESET}... " >&2

  # 1. On macOS, write LaunchAgent so macOS starts it on login and keeps it alive across reboots.
  local launched_via_launchd=false
  if [[ "$(uname -s)" == "Darwin" ]]; then
    web_write_launchagent "$web_py" "$host" "$port" "$log_file"
    launchctl bootout "gui/$(id -u)/${WEB_LAUNCHD_LABEL}" 2>/dev/null || launchctl unload "$WEB_LAUNCHD_PLIST" 2>/dev/null || true
    if launchctl bootstrap "gui/$(id -u)" "$WEB_LAUNCHD_PLIST" 2>/dev/null || launchctl load -w "$WEB_LAUNCHD_PLIST" 2>/dev/null; then
      # Wait up to 3s to see if launchd spawned the server
      local lw=0
      while [[ $lw -lt 6 ]]; do
        if [[ -n "$(web_pid "$port" || true)" ]]; then
          launched_via_launchd=true
          break
        fi
        sleep 0.5
        lw=$((lw + 1))
      done
    fi
  fi

  # 2. If launchd did not spawn it immediately (e.g. non-GUI shell or Linux), start the auto-restart supervisor loop.
  if [[ "$launched_via_launchd" == false ]]; then
    local sup_script="${CONFIG_DIR}/web_keepalive.sh"
    cat > "$sup_script" <<SUPEOF
#!/usr/bin/env bash
echo \$\$ > "${CONFIG_DIR}/web_supervisor.pid"
child_pid=""
cleanup() {
  [[ -n "\$child_pid" ]] && kill -15 "\$child_pid" 2>/dev/null || true
  rm -f "${CONFIG_DIR}/web_supervisor.pid" "${CONFIG_DIR}/web.pid"
  exit 0
}
trap cleanup SIGTERM SIGINT SIGHUP
while true; do
  "${web_py}" "${SCRIPT_DIR}/web_ui.py" --host "${host}" --port "${port}" >> "${log_file}" 2>&1 &
  child_pid=\$!
  wait "\$child_pid"
  rc=\$?
  # If killed by signal via cleanup, exit loop; otherwise restart after 2s
  if [[ ! -f "${CONFIG_DIR}/web_supervisor.pid" ]]; then
    break
  fi
  sleep 2
done
SUPEOF
    chmod +x "$sup_script"
    nohup "$sup_script" >/dev/null 2>&1 &
    disown $! 2>/dev/null || true
  fi

  # Wait up to 10s for HTTP health response
  local waited=0
  local new_pid=""
  while [[ $waited -lt 20 ]]; do
    new_pid=$(web_pid "$port" || true)
    if [[ -n "$new_pid" ]] && curl -s --max-time 1 "http://${host}:${port}/api/health" >/dev/null 2>&1; then
      local mode; mode=$(web_keepalive_mode)
      echo -e "${GREEN}✓ done${RESET} ${DIM}(pid: ${new_pid}, keepalive: ${mode})${RESET}" >&2
      return 0
    fi
    sleep 0.5
    waited=$((waited + 1))
  done

  new_pid=$(web_pid "$port" || true)
  if [[ -n "$new_pid" ]]; then
    echo -e "${GREEN}✓ started${RESET} ${DIM}(pid: ${new_pid})${RESET}" >&2
    return 0
  else
    echo -e "${RED}✗ failed${RESET}" >&2
    [[ -f "$log_file" ]] && tail -n 20 "$log_file" >&2
    return 1
  fi
}

web_stop_one() {
  local port="${1:-$WEB_DEFAULT_PORT}"
  local sup_pid_file="${CONFIG_DIR}/web_supervisor.pid"
  local pid_file="${CONFIG_DIR}/web.pid"

  # 1. Unload and remove macOS LaunchAgent so launchd does not respawn it while stopped
  if [[ "$(uname -s)" == "Darwin" ]] && [[ -f "$WEB_LAUNCHD_PLIST" ]]; then
    launchctl bootout "gui/$(id -u)/${WEB_LAUNCHD_LABEL}" 2>/dev/null || launchctl unload -w "$WEB_LAUNCHD_PLIST" 2>/dev/null || true
    rm -f "$WEB_LAUNCHD_PLIST" 2>/dev/null || true
  fi

  # 2. Stop supervisor loop if running
  if [[ -f "$sup_pid_file" ]]; then
    local sp; sp=$(cat "$sup_pid_file" 2>/dev/null | xargs)
    rm -f "$sup_pid_file" 2>/dev/null || true
    if [[ -n "$sp" ]] && kill -0 "$sp" 2>/dev/null; then
      kill -15 "$sp" 2>/dev/null || true
    fi
  fi

  # 3. Stop web_ui.py process if running
  local pid; pid=$(web_pid "$port" || true)
  if [[ -z "$pid" ]]; then
    rm -f "$pid_file" 2>/dev/null || true
    echo -e "  Web UI Server is not running." >&2
    return 0
  fi

  echo -ne "  Stopping Web UI Server (pid ${pid})... " >&2
  kill -15 "$pid" 2>/dev/null || true
  local waited=0
  while kill -0 "$pid" 2>/dev/null && [[ $waited -lt 6 ]]; do
    sleep 0.5
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file" 2>/dev/null || true
  echo -e "${GREEN}✓ stopped${RESET}" >&2
}

cmd_web() {
  local action="${1:-status}"
  shift || true
  local host="$WEB_DEFAULT_HOST"
  local port="$WEB_DEFAULT_PORT"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="${2:-$WEB_DEFAULT_HOST}"; shift 2 ;;
      --port|-p) port="${2:-$WEB_DEFAULT_PORT}"; shift 2 ;;
      *) shift ;;
    esac
  done

  case "$action" in
    status)
      header
      echo "" >&2
      echo -e "${BOLD}Web UI Sidecar Server${RESET}  ${DIM}(persistent local web interface)${RESET}" >&2
      echo -e "${DIM}───────────────────────────────────────────────────────${RESET}" >&2
      web_status_one "$host" "$port"
      echo "" >&2
      echo -e "${DIM}Commands: speak web [start|stop|restart|status|open|logs] [--port 2420]${RESET}" >&2
      ;;
    start)
      header
      echo "" >&2
      web_start_one "$host" "$port"
      echo "" >&2
      ;;
    stop)
      header
      echo "" >&2
      web_stop_one "$port"
      echo "" >&2
      ;;
    restart)
      header
      echo "" >&2
      web_stop_one "$port"
      web_start_one "$host" "$port"
      echo "" >&2
      ;;
    open)
      header
      echo "" >&2
      web_start_one "$host" "$port"
      local url="http://${host}:${port}"
      if command -v open >/dev/null 2>&1; then
        open "$url"
      elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url"
      fi
      echo -e "  ${GREEN}✓${RESET} Opened ${CYAN}${url}${RESET}" >&2
      echo "" >&2
      ;;
    logs|log)
      local log_file="${CONFIG_DIR}/web_ui.log"
      if [[ -f "$log_file" ]]; then
        tail -n 40 "$log_file"
      else
        echo -e "${DIM}No Web UI log file found at ${log_file}${RESET}" >&2
      fi
      ;;
    *)
      err "Unknown web action: $action. Choose: start, stop, restart, status, open, or logs."
      echo -e "${DIM}Usage: speak web [start|stop|restart|status|open|logs] [--port 2420] [--host 127.0.0.1]${RESET}" >&2
      exit 1
      ;;
  esac
}

cmd_daemon() {
  local action="${1:-status}"
  local target="${2:-all}"

  case "$action" in
    status)
      header
      echo "" >&2
      echo -e "${BOLD}Local Daemons & Web Server${RESET}  ${DIM}(resident models & persistent Web UI)${RESET}" >&2
      echo -e "${DIM}───────────────────────────────────────────────────────${RESET}" >&2
      daemon_status_one "kokoro" "Kokoro TTS"
      daemon_status_one "bark" "Suno Bark"
      web_status_one "$WEB_DEFAULT_HOST" "$WEB_DEFAULT_PORT"
      echo "" >&2
      echo -e "${DIM}Commands: speak daemon start [all|kokoro|bark|web] | speak daemon stop | speak web status${RESET}" >&2
      ;;
    start)
      header
      echo "" >&2
      echo -e "${BOLD}Starting Local Daemons...${RESET}" >&2
      echo -e "${DIM}───────────────────────────────────────────────────────${RESET}" >&2
      case "$target" in
        bark)
          daemon_start_one "bark" "Suno Bark" "${ENGINES_DIR}/bark_daemon.py"
          ;;
        kokoro)
          daemon_start_one "kokoro" "Kokoro TTS" "${ENGINES_DIR}/kokoro_daemon.py"
          ;;
        web)
          web_start_one "$WEB_DEFAULT_HOST" "$WEB_DEFAULT_PORT"
          ;;
        all|"")
          daemon_start_one "kokoro" "Kokoro TTS" "${ENGINES_DIR}/kokoro_daemon.py"
          daemon_start_one "bark" "Suno Bark" "${ENGINES_DIR}/bark_daemon.py"
          web_start_one "$WEB_DEFAULT_HOST" "$WEB_DEFAULT_PORT"
          ;;
        *)
          err "Unknown daemon target: $target. Choose: all, kokoro, bark, or web."
          exit 1
          ;;
      esac
      echo "" >&2
      ;;
    stop)
      header
      echo "" >&2
      echo -e "${BOLD}Stopping Local Daemons...${RESET}" >&2
      echo -e "${DIM}───────────────────────────────────────────────────────${RESET}" >&2
      case "$target" in
        bark)
          daemon_stop_one "bark" "Suno Bark"
          ;;
        kokoro)
          daemon_stop_one "kokoro" "Kokoro TTS"
          ;;
        web)
          web_stop_one "$WEB_DEFAULT_PORT"
          ;;
        all|"")
          daemon_stop_one "kokoro" "Kokoro TTS"
          daemon_stop_one "bark" "Suno Bark"
          web_stop_one "$WEB_DEFAULT_PORT"
          ;;
        *)
          err "Unknown daemon target: $target. Choose: all, kokoro, bark, or web."
          exit 1
          ;;
      esac
      echo "" >&2
      ;;
    restart)
      cmd_daemon stop "$target"
      cmd_daemon start "$target"
      ;;
    *)
      err "Unknown daemon action: $action. Choose: status, start, stop, or restart."
      echo -e "${DIM}Usage: speak daemon [start|stop|restart|status] [all|kokoro|bark|web]${RESET}" >&2
      exit 1
      ;;
  esac
}

# ── Synthesis & Playback Queue (`speak queue`) ───────────────────────
# Canonical CLI queue persisted in outputs/queue.json (+ per-file .json sidecars).
# Reconciles any .wav files in outputs/ so nothing is ever orphaned or lost.
queue_register_output() {
  local wav_path="$1" persona="$2" badge="$3" engine="$4" transcript="$5" set_active="${6:-false}"
  mkdir -p "$QUEUE_DIR"
  "$PYTHON" - "$QUEUE_DIR" "$QUEUE_FILE" "$wav_path" "$persona" "$badge" "$engine" "$transcript" "$set_active" <<'PYEOF'
import sys, os, json, wave, datetime
from pathlib import Path

queue_dir = Path(sys.argv[1]).resolve()
queue_file = Path(sys.argv[2]).resolve()
wav_path = Path(sys.argv[3]).resolve()
persona = sys.argv[4]
badge = sys.argv[5]
engine = sys.argv[6]
transcript = sys.argv[7]
set_active = sys.argv[8].lower() == "true"

if not wav_path.exists():
    sys.exit(0)

# Probe duration via stdlib wave
duration_sec = 0.0
sample_rate = 24000
try:
    with wave.open(str(wav_path), "rb") as wf:
        frames = wf.getnframes()
        rate = wf.getframerate()
        sample_rate = rate
        if rate > 0:
            duration_sec = round(frames / float(rate), 2)
except Exception:
    pass

timing_path = Path(str(wav_path) + ".timing.json")
timing_data = None
if timing_path.exists():
    try:
        timing_data = json.loads(timing_path.read_text(encoding="utf-8"))
    except Exception:
        pass

cleaned_transcript = (timing_data.get("cleaned_text") if isinstance(timing_data, dict) else None) or transcript
item_id = wav_path.stem
now_iso = datetime.datetime.now().isoformat(timespec="seconds")

sidecar_path = wav_path.with_suffix(".json")
existing_sidecar = {}
if sidecar_path.exists():
    try:
        existing_sidecar = json.loads(sidecar_path.read_text(encoding="utf-8"))
    except Exception:
        pass

sidecar_data = {
    "id": item_id,
    "filename": wav_path.name,
    "voice": persona,
    "badge": badge,
    "engine": engine,
    "transcript": cleaned_transcript,
    "duration_seconds": duration_sec,
    "sample_rate": sample_rate,
    "created_at": existing_sidecar.get("created_at") or now_iso,
    "played": bool(existing_sidecar.get("played", False)),
    "status": existing_sidecar.get("status", "unplayed"),
    "position_seconds": float(existing_sidecar.get("position_seconds", 0.0)),
    "timing": timing_data,
}

try:
    sidecar_path.write_text(json.dumps(sidecar_data, indent=2), encoding="utf-8")
except Exception:
    pass

# If the wav is inside QUEUE_DIR, also register/update it in queue.json
if wav_path.parent == queue_dir:
    qdata = {"active_id": None, "items": []}
    if queue_file.exists():
        try:
            loaded = json.loads(queue_file.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                qdata["active_id"] = loaded.get("active_id")
                qdata["items"] = loaded.get("items") if isinstance(loaded.get("items"), list) else []
        except Exception:
            pass

    entry_summary = {k: v for k, v in sidecar_data.items() if k != "timing"}
    entry_summary["url"] = f"/outputs/{wav_path.name}"

    replaced = False
    for idx, it in enumerate(qdata["items"]):
        if it.get("id") == item_id or it.get("filename") == wav_path.name:
            # Preserve existing playback state if re-indexing
            entry_summary["played"] = bool(it.get("played", entry_summary["played"]))
            entry_summary["status"] = it.get("status", entry_summary["status"])
            entry_summary["position_seconds"] = float(it.get("position_seconds", entry_summary["position_seconds"]))
            qdata["items"][idx] = entry_summary
            replaced = True
            break
    if not replaced:
        qdata["items"].insert(0, entry_summary)

    if set_active or not qdata.get("active_id"):
        qdata["active_id"] = item_id

    try:
        queue_file.write_text(json.dumps(qdata, indent=2), encoding="utf-8")
    except Exception:
        pass
PYEOF
}

cmd_queue() {
  local sub="${1:-list}"
  case "$sub" in
    --json)
      sub="list"
      ;;
    list|ls|status|add|state|update|play)
      shift || true
      ;;
    *)
      # If someone passes flags like `speak queue -v river "text"`, treat as `add`
      if [[ "$sub" == -* ]]; then
        sub="add"
      fi
      ;;
  esac

  if [[ "$sub" == "add" ]]; then
    cmd_speak --queue "$@"
    return $?
  fi

  mkdir -p "$QUEUE_DIR"

  if [[ "$sub" == "play" ]]; then
    local target_id="${1:-}"
    local resolved_info
    if ! resolved_info="$("$PYTHON" - "$QUEUE_DIR" "$QUEUE_FILE" "$target_id" <<'PYEOF'
import sys, json
from pathlib import Path

qdir = Path(sys.argv[1]).resolve()
qfile = Path(sys.argv[2]).resolve()
target = sys.argv[3].strip()

qdata = {"active_id": None, "items": []}
if qfile.exists():
    try:
        qdata = json.loads(qfile.read_text(encoding="utf-8"))
    except Exception:
        pass

items = qdata.get("items") or []
chosen = None
if target:
    for it in items:
        if it.get("id") == target or it.get("filename") == target:
            chosen = it
            break
if not chosen and qdata.get("active_id"):
    for it in items:
        if it.get("id") == qdata["active_id"]:
            chosen = it
            break
if not chosen:
    for it in items:
        if not it.get("played"):
            chosen = it
            break
if not chosen and items:
    chosen = items[0]

if not chosen:
    sys.exit(1)

wav_p = qdir / chosen["filename"]
if not wav_p.exists():
    sys.exit(1)

print(chosen.get("id", wav_p.stem))
print(str(wav_p))
print(chosen.get("voice") or "puck")
print(chosen.get("transcript") or "")
PYEOF
    )"; then
      err "No matching item in queue to play."
      exit 1
    fi

    local play_id play_wav play_voice play_text
    { IFS= read -r play_id; IFS= read -r play_wav; IFS= read -r play_voice; play_text="$(cat)"; } <<< "$resolved_info"

    cmd_queue state "$play_id" --status playing --active >/dev/null
    if [[ -t 2 && -f "${SCRIPT_DIR}/visualizer.py" ]]; then
      "$PYTHON" "${SCRIPT_DIR}/visualizer.py" "$play_wav" "$play_voice" "$play_text" --lines 3 --highlight word --emphasis "${CFG_EMPHASIS:-bold}" --view "${CFG_VIEW:-scroll}"
    elif command -v afplay &>/dev/null; then
      afplay "$play_wav"
    fi
    cmd_queue state "$play_id" --status played --played true --position 0 >/dev/null
    return 0
  fi

  # For `list` and `state` / `update`, run Python reconciliation + mutation + display/JSON
  "$PYTHON" - "$QUEUE_DIR" "$QUEUE_FILE" "$sub" "$@" <<'PYEOF'
import sys, os, json, wave, datetime
from pathlib import Path

qdir = Path(sys.argv[1]).resolve()
qfile = Path(sys.argv[2]).resolve()
action = sys.argv[3]
args = sys.argv[4:]

def probe_wav(p: Path):
    dur = 0.0
    rate = 24000
    try:
        with wave.open(str(p), "rb") as wf:
            frames = wf.getnframes()
            rate = wf.getframerate()
            if rate > 0:
                dur = round(frames / float(rate), 2)
    except Exception:
        pass
    return dur, rate

# 1. Load queue.json if present
qdata = {"active_id": None, "items": []}
if qfile.exists():
    try:
        loaded = json.loads(qfile.read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            qdata["active_id"] = loaded.get("active_id")
            if isinstance(loaded.get("items"), list):
                qdata["items"] = loaded["items"]
    except Exception:
        pass

# 2. Reconcile with outputs/*.wav so all existing WAV files are in the queue
existing_by_name = {it.get("filename"): it for it in qdata["items"] if isinstance(it, dict) and it.get("filename")}
wav_files = sorted(qdir.glob("*.wav"), key=lambda p: p.stat().st_mtime, reverse=True)

reconciled = []
seen_names = set()

# Keep existing ordering first for items whose .wav still exists
for it in qdata["items"]:
    fname = it.get("filename")
    if not fname:
        continue
    wp = qdir / fname
    if not wp.exists():
        continue
    seen_names.add(fname)
    reconciled.append(it)

# Prepend/add any newly discovered .wav files in outputs/
for wp in wav_files:
    if wp.name in seen_names:
        continue
    seen_names.add(wp.name)
    dur, rate = probe_wav(wp)
    sidecar_p = wp.with_suffix(".json")
    sc = {}
    if sidecar_p.exists():
        try:
            sc = json.loads(sidecar_p.read_text(encoding="utf-8"))
        except Exception:
            pass
    timing_p = Path(str(wp) + ".timing.json")
    t_data = sc.get("timing")
    if not t_data and timing_p.exists():
        try:
            t_data = json.loads(timing_p.read_text(encoding="utf-8"))
        except Exception:
            pass
    transcript = sc.get("transcript") or (t_data.get("cleaned_text") if isinstance(t_data, dict) else "") or ""
    mtime_iso = datetime.datetime.fromtimestamp(wp.stat().st_mtime).isoformat(timespec="seconds")
    item_id = wp.stem
    played = bool(sc.get("played", False))
    pos = float(sc.get("position_seconds", 0.0))
    status = sc.get("status") or ("played" if played else "unplayed")
    entry = {
        "id": item_id,
        "filename": wp.name,
        "url": f"/outputs/{wp.name}",
        "voice": sc.get("voice") or "puck",
        "badge": sc.get("badge") or sc.get("voice") or "puck",
        "engine": sc.get("engine") or "kokoro",
        "transcript": transcript,
        "duration_seconds": sc.get("duration_seconds") or dur,
        "sample_rate": sc.get("sample_rate") or rate,
        "created_at": sc.get("created_at") or mtime_iso,
        "played": played,
        "status": status,
        "position_seconds": pos,
    }
    reconciled.append(entry)

# Sort reconciled newest-first by created_at if queue was just initialized
qdata["items"] = reconciled

# Ensure active_id points to a valid item
valid_ids = {it["id"] for it in qdata["items"]}
if not qdata.get("active_id") or qdata["active_id"] not in valid_ids:
    # Default active_id to the first unplayed item, or first item
    unplayed_first = next((it["id"] for it in qdata["items"] if not it.get("played")), None)
    qdata["active_id"] = unplayed_first or (qdata["items"][0]["id"] if qdata["items"] else None)

json_mode = "--json" in args

if action in ("state", "update"):
    # Parse: <id> [--position SEC] [--played BOOL] [--status STATUS] [--active] [--json]
    clean_args = [a for a in args if a != "--json"]
    if not clean_args:
        print("Error: speak queue state requires an item <id>", file=sys.stderr)
        sys.exit(1)
    target_id = clean_args[0]
    new_pos = None
    new_played = None
    new_status = None
    make_active = False

    i = 1
    while i < len(clean_args):
        flag = clean_args[i]
        if flag == "--position" and i + 1 < len(clean_args):
            try:
                new_pos = max(0.0, float(clean_args[i + 1]))
            except ValueError:
                pass
            i += 2
        elif flag == "--played" and i + 1 < len(clean_args):
            new_played = clean_args[i + 1].lower() in ("true", "1", "yes")
            i += 2
        elif flag == "--status" and i + 1 < len(clean_args):
            new_status = clean_args[i + 1].lower()
            i += 2
        elif flag == "--active":
            make_active = True
            i += 1
        else:
            i += 1

    matched = None
    for it in qdata["items"]:
        if it.get("id") == target_id or it.get("filename") == target_id:
            matched = it
            break

    if not matched:
        print(f"Error: queue item '{target_id}' not found", file=sys.stderr)
        sys.exit(1)

    if new_pos is not None:
        dur = float(matched.get("duration_seconds") or 0.0)
        if dur > 0:
            new_pos = min(dur, new_pos)
        matched["position_seconds"] = round(new_pos, 2)

    if new_played is not None:
        matched["played"] = new_played
        if new_played and not new_status:
            matched["status"] = "played"
        elif not new_played and not new_status:
            matched["status"] = "unplayed"

    if new_status is not None:
        matched["status"] = new_status
        if new_status == "played":
            matched["played"] = True
        elif new_status == "unplayed":
            matched["played"] = False

    if make_active or new_status == "playing":
        qdata["active_id"] = matched["id"]

    # Persist back to sidecar .json as well
    wp = qdir / matched["filename"]
    sidecar_p = wp.with_suffix(".json")
    if sidecar_p.exists():
        try:
            sc = json.loads(sidecar_p.read_text(encoding="utf-8"))
            sc["played"] = matched["played"]
            sc["status"] = matched["status"]
            sc["position_seconds"] = matched["position_seconds"]
            sidecar_p.write_text(json.dumps(sc, indent=2), encoding="utf-8")
        except Exception:
            pass

# Save reconciled/updated queue.json
try:
    qfile.write_text(json.dumps(qdata, indent=2), encoding="utf-8")
except Exception:
    pass

# Enrich items with `is_active` and `timing` for output
enriched_items = []
for it in qdata["items"]:
    copy_it = dict(it)
    copy_it["is_active"] = (it.get("id") == qdata.get("active_id"))
    wp = qdir / it["filename"]
    timing_p = Path(str(wp) + ".timing.json")
    sidecar_p = wp.with_suffix(".json")
    t_data = None
    if timing_p.exists():
        try:
            t_data = json.loads(timing_p.read_text(encoding="utf-8"))
        except Exception:
            pass
    if not t_data and sidecar_p.exists():
        try:
            sc = json.loads(sidecar_p.read_text(encoding="utf-8"))
            t_data = sc.get("timing")
        except Exception:
            pass
    copy_it["timing"] = t_data
    enriched_items.append(copy_it)

total_cnt = len(enriched_items)
played_cnt = sum(1 for it in enriched_items if it.get("played"))
unplayed_cnt = total_cnt - played_cnt

out_payload = {
    "active_id": qdata.get("active_id"),
    "counts": {
        "total": total_cnt,
        "unplayed": unplayed_cnt,
        "played": played_cnt,
    },
    "items": enriched_items,
}

if json_mode:
    print(json.dumps(out_payload, indent=2))
else:
    def fmt_mmss(sec):
        sec = max(0, int(round(float(sec or 0))))
        return f"{sec // 60:02d}:{sec % 60:02d}"

    BOLD = "\033[1m"
    DIM = "\033[2m"
    RESET = "\033[0m"
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"

    print(f"{BOLD}{CYAN}speak{RESET} {DIM}queue — {unplayed_cnt} unplayed · {played_cnt} played ({total_cnt} total){RESET}", file=sys.stderr)
    print(f"{DIM}{'─' * 72}{RESET}", file=sys.stderr)
    if not enriched_items:
        print(f"  {DIM}Queue is empty. Run: speak -Q \"text to synthesize\"{RESET}", file=sys.stderr)
    for it in enriched_items:
        is_act = it.get("is_active")
        played = it.get("played")
        pos = float(it.get("position_seconds") or 0.0)
        dur = float(it.get("duration_seconds") or 0.0)
        if is_act:
            marker = f"{BOLD}{GREEN}▶ ACTIVE  {RESET}"
        elif played:
            marker = f"{DIM}✓ PLAYED  {RESET}"
        elif pos > 0:
            marker = f"{YELLOW}◐ RESUME  {RESET}"
        else:
            marker = f"{CYAN}○ UNPLAYED{RESET}"

        voice = (it.get("voice") or "voice").upper().ljust(8)
        time_str = f"{fmt_mmss(pos)}/{fmt_mmss(dur)}"
        snippet = (it.get("transcript") or "").replace("\n", " ").strip()
        if len(snippet) > 42:
            snippet = snippet[:39] + "..."
        line_str = f"  {marker} {BOLD}{voice}{RESET} [{time_str}]  {DIM}{it['id']}{RESET}  \"{snippet}\""
        print(line_str, file=sys.stderr)
PYEOF
}

