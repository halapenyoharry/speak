# ── Config management ────────────────────────────────────────────────
load_config() {
  DEFAULT_VOICE="Puck"
  DEFAULT_MODEL="gemini-3.1-flash-tts-preview"
  DEFAULT_OPTIMIZE_MODEL="gemini-2.5-flash"
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS='=' read -r key value; do
      [[ -z "$key" || "$key" == \#* ]] && continue
      key=$(echo "$key" | xargs)
      value=$(echo "$value" | xargs)
      case "$key" in
        voice) DEFAULT_VOICE="$value" ;;
        tts_model) DEFAULT_MODEL="$value" ;;
        optimize_model) DEFAULT_OPTIMIZE_MODEL="$value" ;;
      esac
    done < "$CONFIG_FILE"
  fi
}

save_config_value() {
  mkdir -p "$CONFIG_DIR"
  local key="$1" value="$2"
  if [[ -f "$CONFIG_FILE" ]] && grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i '' "s|^${key}=.*|${key}=${value}|" "$CONFIG_FILE"
  else
    echo "${key}=${value}" >> "$CONFIG_FILE"
  fi
}

# ── Voice lookup ─────────────────────────────────────────────────────
get_voice_entry() {
  local name="$1"
  for v in "${VOICES[@]}"; do
    local vname="${v%%|*}"
    if [[ "$(tolower "$vname")" == "$(tolower "$name")" ]]; then
      echo "$v"
      return 0
    fi
  done
  return 1
}

print_voice_badge() {
  local name="$1"
  local entry
  if entry=$(get_voice_entry "$name"); then
    IFS='|' read -r vname vstyle vcolor vglyph <<< "$entry"
    printf "\033[${vcolor}m${vglyph} ${vname}\033[0m"
  else
    printf "$name"
  fi
}

# ── Display functions ────────────────────────────────────────────────
header() {
  echo -e "${BOLD}${CYAN}speak${RESET} ${DIM}v${VERSION}${RESET}" >&2
}

label() {
  echo -ne "${GRAY}$1${RESET}" >&2
}

info() {
  echo -e "${DIM}$1${RESET}" >&2
}

err() {
  echo -e "${RED}✗ $1${RESET}" >&2
}

# ── Subcommands ──────────────────────────────────────────────────────
cmd_voices() {
  header
  echo "" >&2
  echo -e "${BOLD}Available voices${RESET}" >&2
  echo -e "${DIM}──────────────────────────────────${RESET}" >&2
  for v in "${VOICES[@]}"; do
    IFS='|' read -r vname vstyle vcolor vglyph <<< "$v"
    local marker=""
    if [[ "$(tolower "$vname")" == "$(tolower "$DEFAULT_VOICE")" ]]; then
      marker=" ${GREEN}← default${RESET}"
    fi
    printf "  \033[${vcolor}m${vglyph}  %-16s\033[0m ${DIM}%s${RESET}%b\n" "$vname" "$vstyle" "$marker" >&2
  done
  echo "" >&2
  echo -e "${DIM}Set default: speak set voice <name>${RESET}" >&2
}

cmd_set() {
  if [[ $# -lt 2 ]]; then
    header
    echo "" >&2
    echo -e "${BOLD}Current config${RESET} ${DIM}(${CONFIG_FILE})${RESET}" >&2
    echo -e "${DIM}──────────────────────────────────${RESET}" >&2
    echo -ne "  voice           " >&2; print_voice_badge "$DEFAULT_VOICE" >&2; echo "" >&2
    echo -e "  tts_model       ${DIM}${DEFAULT_MODEL}${RESET}" >&2
    echo -e "  optimize_model  ${DIM}${DEFAULT_OPTIMIZE_MODEL}${RESET}" >&2
    echo "" >&2
    return
  fi
  local key="$1" value="$2"
  case "$key" in
    voice)
      if ! get_voice_entry "$value" >/dev/null; then
        err "Unknown voice: $value"
        echo -e "${DIM}Run 'speak voices' to see options${RESET}" >&2
        exit 1
      fi
      # Normalize capitalization
      local entry
      entry=$(get_voice_entry "$value")
      value="${entry%%|*}"
      save_config_value "voice" "$value"
      echo -ne "${GREEN}✓${RESET} Default voice set to " >&2
      print_voice_badge "$value" >&2
      echo "" >&2
      ;;
    tts_model|optimize_model)
      save_config_value "$key" "$value"
      echo -e "${GREEN}✓${RESET} ${key} set to ${BOLD}${value}${RESET}" >&2
      ;;
    *)
      err "Unknown config key: $key"
      echo -e "${DIM}Valid keys: voice, tts_model, optimize_model${RESET}" >&2
      exit 1
      ;;
  esac
}

