#!/usr/bin/env bash
# speak — persona-driven text-to-speech with narration intelligence
# https://github.com/haroldyoung/speak
#
# CLEAN-SLATE REWRITE (feat/engine-persona-rewrite). Strangler refactor of the
# original 939-line driver: orchestration preserved verbatim; the per-engine
# synthesis bodies now live in engines/<engine>.{sh,py} per engines/CONTRACT.md.
#
# Data (DATA out of CODE):
#   voices.yaml   — personas + per-engine realizations (no fallback, no default realization)
#   engines.yaml  — engine capabilities/models/auth/format/concurrency/preconditions
# Both are parsed + VALIDATED at startup via python3 + PyYAML (fail loud).
#
# THREE engines only: gemini | gcloud | kokoro. .wrangler/ is a deployment
# target, NOT a TTS engine, and is deliberately untouched.
set -euo pipefail

VERSION="0.2.0"
CONFIG_DIR="${HOME}/.config/speak"
CONFIG_FILE="${CONFIG_DIR}/config"
SPEAK_TMPDIR=""   # set by cmd_speak; referenced by the EXIT-cleanup trap

# ── Robust symlink resolution to find SCRIPT_DIR ─────────────────────
# speak is installed as a symlink at /opt/homebrew/bin/speak -> repo/speak.
# We resolve through the readlink loop so the driver finds its sibling
# engines/, voices.yaml, and engines.yaml regardless of how it's invoked.
# (behavior #10)
_resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  local dir
  while [[ -h "$source" ]]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}
SCRIPT_DIR="$(_resolve_script_dir)"
ENGINES_DIR="${SCRIPT_DIR}/engines"
VOICES_YAML="${SCRIPT_DIR}/voices.yaml"
ENGINES_YAML="${SCRIPT_DIR}/engines.yaml"

# ── Terminal formatting ──────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
ITALIC='\033[3m'
RESET='\033[0m'
RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
CYAN='\033[36m'
WHITE='\033[37m'
GRAY='\033[90m'
BG_BLACK='\033[40m'

# Disable colors if stderr is not a terminal (behavior #6c). All human-facing
# chrome targets stderr (behavior #19), so the TTY test is on fd 2.
if [[ ! -t 2 ]]; then
  BOLD="" DIM="" ITALIC="" RESET="" RED="" GREEN="" YELLOW=""
  BLUE="" MAGENTA="" CYAN="" WHITE="" GRAY="" BG_BLACK=""
fi

# ── small helpers ────────────────────────────────────────────────────
tolower() { printf "%s" "$1" | tr "[:upper:]" "[:lower:]"; }

err() { echo -e "${RED}✗ $1${RESET}" >&2; }
info() { echo -e "${DIM}$1${RESET}" >&2; }
header() { echo -e "${BOLD}${CYAN}speak${RESET} ${DIM}v${VERSION}${RESET}" >&2; }

# ── PyYAML precondition: pick an interpreter that can import yaml ─────
# Treat PyYAML as a hard precondition. Probe candidate interpreters; the
# default `python3` may be the Xcode/system one without PyYAML while a
# Homebrew/usr-local one has it. If NONE can import yaml, error loudly with
# `pip3 install pyyaml` and never silently degrade.
PYTHON=""
_resolve_python() {
  local candidates=()
  # Honor an explicit override first.
  [[ -n "${SPEAK_PYTHON:-}" ]] && candidates+=("$SPEAK_PYTHON")
  # Whatever `python3` resolves to on PATH.
  if command -v python3 >/dev/null 2>&1; then
    candidates+=("$(command -v python3)")
  fi
  # Common alternative install locations.
  candidates+=(/opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3)
  local c
  for c in "${candidates[@]}"; do
    [[ -x "$c" ]] || continue
    if "$c" -c 'import yaml' >/dev/null 2>&1; then
      PYTHON="$c"
      return 0
    fi
  done
  return 1
}
if ! _resolve_python; then
  err "PyYAML is required but not importable by any available python3."
  echo -e "${DIM}voices.yaml / engines.yaml are parsed with python3 + PyYAML.${RESET}" >&2
  echo -e "${DIM}Install it:  pip3 install pyyaml${RESET}" >&2
  echo -e "${DIM}(or set SPEAK_PYTHON=/path/to/python3 that already has it)${RESET}" >&2
  exit 1
fi

# JSON-escape a string into a JSON string literal (used for API payloads &
# building --json output). Uses the resolved interpreter (json is stdlib).
json_escape() {
  printf '%s' "$1" | "$PYTHON" -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
}

# ── YAML data access (single source of truth: the two yaml files) ─────
# A tiny query helper. We keep the heavy validation in validate_data() and
# use yq-style lookups elsewhere. All YAML parsing goes through $PYTHON.
yaml_query() {
  # $1 = yaml file, rest = python expression operating on `d` (the loaded dict)
  local file="$1"; shift
  "$PYTHON" - "$file" "$*" <<'PYEOF'
import sys, yaml
file = sys.argv[1]
expr = sys.argv[2]
with open(file) as fh:
    d = yaml.safe_load(fh)
val = eval(expr, {"d": d})
if val is None:
    pass
elif isinstance(val, (list, tuple)):
    print("\n".join(str(x) for x in val))
else:
    print(val)
PYEOF
}

# ── Startup validation gate (fail loud, exit nonzero) ────────────────
# Validates BOTH yaml files against the target.v2 schema invariants. Any
# unknown engine/persona/capability/blend-voice/model, or any structural
# violation, errors and exits nonzero. The driver MUST NOT contain a
# "default realization" or "nearest-voice" path; this gate is what keeps the
# data honest. (key-design-move: DATA out of CODE with a fail-loud gate)
validate_data() {
  local report
  if ! report="$("$PYTHON" - "$VOICES_YAML" "$ENGINES_YAML" <<'PYEOF'
import sys, yaml

voices_path, engines_path = sys.argv[1], sys.argv[2]
errors = []

def load(path, label):
    try:
        with open(path) as fh:
            return yaml.safe_load(fh)
    except FileNotFoundError:
        errors.append(f"{label} not found at {path}")
    except yaml.YAMLError as e:
        errors.append(f"{label} is not valid YAML: {e}")
    return None

engines = load(engines_path, "engines.yaml")
voices = load(voices_path, "voices.yaml")
if errors:
    print("\n".join(errors)); sys.exit(2)

VALID_ENGINES = {"gemini", "gcloud", "kokoro"}
VALID_FORMATS = {"pcm-s16le-24k-mono", "linear16", "wav"}
VALID_BILLING = {"tokens", "characters", "none"}

# ---- engines.yaml ----
if not isinstance(engines, dict):
    errors.append("engines.yaml: top-level must be a mapping")
else:
    opt = engines.get("optimizer")
    if not isinstance(opt, dict):
        errors.append("engines.yaml: missing top-level `optimizer` section")
    else:
        for k in ("model", "auth", "provides_capability"):
            if k not in opt:
                errors.append(f"engines.yaml: optimizer missing `{k}`")
        if opt.get("provides_capability") != "audio-tags":
            errors.append("engines.yaml: optimizer.provides_capability must be `audio-tags`")

    eng = engines.get("engines")
    if not isinstance(eng, dict):
        errors.append("engines.yaml: missing `engines` mapping")
    else:
        keys = set(eng.keys())
        if keys != VALID_ENGINES:
            errors.append(f"engines.yaml: engines must be exactly {sorted(VALID_ENGINES)}, got {sorted(keys)}")
        for name, e in eng.items():
            if not isinstance(e, dict):
                errors.append(f"engines.yaml: engine `{name}` must be a mapping"); continue
            for f in ("label","deployment","auth","capabilities","default_model","models",
                      "output_format","needs_transcode","billing_unit","max_in_flight",
                      "default_persona","preconditions"):
                if f not in e:
                    errors.append(f"engines.yaml: engine `{name}` missing field `{f}`")
            # `endpoint` is load-bearing for cloud engines (read at optimize/synth
            # time); offline engines (kokoro) legitimately have none.
            if e.get("deployment") == "cloud-api" and not e.get("endpoint"):
                errors.append(f"engines.yaml: cloud engine `{name}` missing `endpoint`")
            caps = e.get("capabilities")
            if not isinstance(caps, list):
                errors.append(f"engines.yaml: engine `{name}`.capabilities must be a list")
            else:
                for c in caps:
                    if c != "audio-tags":
                        errors.append(f"engines.yaml: engine `{name}` has unknown capability `{c}`")
            if e.get("output_format") not in VALID_FORMATS:
                errors.append(f"engines.yaml: engine `{name}`.output_format `{e.get('output_format')}` not in {sorted(VALID_FORMATS)}")
            if e.get("billing_unit") not in VALID_BILLING:
                errors.append(f"engines.yaml: engine `{name}`.billing_unit `{e.get('billing_unit')}` not in {sorted(VALID_BILLING)}")
            mif = e.get("max_in_flight")
            if not isinstance(mif, int) or mif < 1:
                errors.append(f"engines.yaml: engine `{name}`.max_in_flight must be int >= 1")
            models = e.get("models")
            if not isinstance(models, dict):
                errors.append(f"engines.yaml: engine `{name}`.models must be a mapping")
            elif e.get("default_model") not in models:
                errors.append(f"engines.yaml: engine `{name}`.default_model `{e.get('default_model')}` not a key of models")
            dp = e.get("default_persona")
            # cross-checked against personas below
            e["_default_persona"] = dp

# kokoro native_voices sanity (locale lookup data, not bf_/bm_ prefix)
kokoro = (engines or {}).get("engines", {}).get("kokoro", {}) if isinstance(engines, dict) else {}
native = kokoro.get("native_voices", {}) if isinstance(kokoro, dict) else {}
if not isinstance(native, dict) or not native:
    errors.append("engines.yaml: kokoro.native_voices must be a non-empty mapping")

# ---- voices.yaml ----
persona_ids = set()
if not isinstance(voices, dict):
    errors.append("voices.yaml: top-level must be a mapping")
else:
    dp = voices.get("default_persona")
    personas = voices.get("personas")
    if not isinstance(personas, dict) or not personas:
        errors.append("voices.yaml: missing `personas` mapping")
    else:
        persona_ids = set(personas.keys())
        if dp not in persona_ids:
            errors.append(f"voices.yaml: default_persona `{dp}` is not a defined persona")
        default_flagged = [pid for pid,p in personas.items() if isinstance(p,dict) and p.get("default")]
        if len(default_flagged) > 1:
            errors.append(f"voices.yaml: more than one persona marked default: {default_flagged}")
        for pid, p in personas.items():
            if pid != pid.lower():
                errors.append(f"voices.yaml: persona id `{pid}` must be lowercase")
            if not isinstance(p, dict):
                errors.append(f"voices.yaml: persona `{pid}` must be a mapping"); continue
            for f in ("style","glyph","color"):
                if f not in p:
                    errors.append(f"voices.yaml: persona `{pid}` missing `{f}`")
            reals = p.get("realizations")
            if not isinstance(reals, dict) or not reals:
                errors.append(f"voices.yaml: persona `{pid}` has no realizations")
                continue
            for ek, r in reals.items():
                if ek not in VALID_ENGINES:
                    errors.append(f"voices.yaml: persona `{pid}` realization names unknown engine `{ek}`")
                    continue
                if not isinstance(r, dict):
                    errors.append(f"voices.yaml: persona `{pid}`.{ek} must be a mapping"); continue
                has_voice = "voice" in r
                has_blend = "blend" in r
                if ek == "kokoro":
                    if has_voice == has_blend:
                        errors.append(f"voices.yaml: persona `{pid}`.kokoro must have EXACTLY one of voice|blend")
                    if has_blend:
                        blend = r["blend"]
                        if not isinstance(blend, list) or not blend:
                            errors.append(f"voices.yaml: persona `{pid}`.kokoro.blend must be a non-empty list")
                        else:
                            for comp in blend:
                                if not isinstance(comp, dict) or "voice" not in comp or "weight" not in comp:
                                    errors.append(f"voices.yaml: persona `{pid}`.kokoro.blend component needs voice+weight")
                                elif native and comp["voice"] not in native:
                                    errors.append(f"voices.yaml: persona `{pid}`.kokoro.blend voice `{comp['voice']}` not in engines.yaml native_voices")
                    elif has_voice and native and r["voice"] not in native:
                        errors.append(f"voices.yaml: persona `{pid}`.kokoro.voice `{r['voice']}` not in engines.yaml native_voices")
                else:
                    if not has_voice:
                        errors.append(f"voices.yaml: persona `{pid}`.{ek} missing `voice`")

# cross-check each engine.default_persona realizes itself (coverage invariant)
if isinstance(engines, dict) and persona_ids:
    for name, e in engines.get("engines", {}).items():
        dp = e.get("_default_persona") if isinstance(e, dict) else None
        if dp is None:
            continue
        p = (voices or {}).get("personas", {}).get(dp)
        if not isinstance(p, dict):
            errors.append(f"coverage: engine `{name}` default_persona `{dp}` is not a defined persona")
        elif name not in (p.get("realizations") or {}):
            errors.append(f"coverage: engine `{name}` default_persona `{dp}` has no `{name}` realization")

if errors:
    print("\n".join(errors)); sys.exit(2)
PYEOF
)"; then
    err "Data validation failed:"
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      echo -e "  ${DIM}${line}${RESET}" >&2
    done <<< "$report"
    echo -e "${DIM}Fix voices.yaml / engines.yaml and retry.${RESET}" >&2
    exit 1
  fi
}

# ── Config management ────────────────────────────────────────────────
# New schema keys: engine, persona, model_overrides.<engine>, optimizer_model.
# Comment-tolerant key=value reader (behavior #13a). Defaults sourced from data.
load_config() {
  CFG_ENGINE=""
  CFG_PERSONA=""
  CFG_OPTIMIZER_MODEL=""
  # Per-engine model overrides stored as model_overrides.<engine>=<model>.
  # Kept as plain scalars (bash 3.2-compatible; no associative arrays) since
  # there are exactly three known engines.
  CFG_MODEL_OVERRIDE_gemini=""
  CFG_MODEL_OVERRIDE_gcloud=""
  CFG_MODEL_OVERRIDE_kokoro=""
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS='=' read -r key value; do
      [[ -z "$key" || "$key" == \#* ]] && continue
      key=$(echo "$key" | xargs)
      value=$(echo "$value" | xargs)
      case "$key" in
        engine) CFG_ENGINE="$value" ;;
        persona) CFG_PERSONA="$value" ;;
        optimizer_model) CFG_OPTIMIZER_MODEL="$value" ;;
        model_overrides.gemini) CFG_MODEL_OVERRIDE_gemini="$value" ;;
        model_overrides.gcloud) CFG_MODEL_OVERRIDE_gcloud="$value" ;;
        model_overrides.kokoro) CFG_MODEL_OVERRIDE_kokoro="$value" ;;
      esac
    done < "$CONFIG_FILE"
  fi
  # Defaults pulled from the validated data files.
  DATA_DEFAULT_PERSONA="$(yaml_query "$VOICES_YAML" 'd.get("default_persona","puck")')"
  OPTIMIZER_MODEL="$(yaml_query "$ENGINES_YAML" 'd["optimizer"]["model"]')"
  if [[ -n "$CFG_OPTIMIZER_MODEL" ]]; then
    OPTIMIZER_MODEL="$CFG_OPTIMIZER_MODEL"
  fi
  return 0
}

# Portable in-place key=value upsert (behavior #13b). Replaces BSD-only
# `sed -i ''`, which is NOT GNU-compatible (latent Pop!_OS/lumen bug). We use
# a python rewrite-to-temp-then-mv via the resolved interpreter — works
# identically on macOS and Linux.
save_config_value() {
  mkdir -p "$CONFIG_DIR"
  local key="$1" value="$2"
  "$PYTHON" - "$CONFIG_FILE" "$key" "$value" <<'PYEOF'
import sys, os, tempfile
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
lines = []
if os.path.exists(path):
    with open(path) as fh:
        lines = fh.read().splitlines()
out = []
found = False
for line in lines:
    stripped = line.strip()
    if stripped and not stripped.startswith("#") and "=" in line:
        k = line.split("=", 1)[0].strip()
        if k == key:
            out.append(f"{key}={value}")
            found = True
            continue
    out.append(line)
if not found:
    out.append(f"{key}={value}")
d = os.path.dirname(path) or "."
os.makedirs(d, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=d)
with os.fdopen(fd, "w") as fh:
    fh.write("\n".join(out) + "\n")
os.replace(tmp, path)
PYEOF
}

# Delete a config key (used when migration replaces a legacy key).
delete_config_value() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  local key="$1"
  "$PYTHON" - "$CONFIG_FILE" "$key" <<'PYEOF'
import sys, os, tempfile
path, key = sys.argv[1], sys.argv[2]
if not os.path.exists(path):
    sys.exit(0)
with open(path) as fh:
    lines = fh.read().splitlines()
out = []
for line in lines:
    stripped = line.strip()
    if stripped and not stripped.startswith("#") and "=" in line:
        k = line.split("=", 1)[0].strip()
        if k == key:
            continue
    out.append(line)
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d)
with os.fdopen(fd, "w") as fh:
    fh.write("\n".join(out) + ("\n" if out else ""))
os.replace(tmp, path)
PYEOF
}

# ── Config migration (runs once; errors on unmappable value) ─────────
# old → new:
#   use_gcloud=true | use_cloud=true   → engine: gcloud
#   use_gcloud=false| use_cloud=false  → engine: gemini
#   voice=Puck                         → persona: puck (lowercase; FAIL if unknown)
#   tts_model=X                        → model_overrides.gemini=X
#   optimize_model=X                   → optimizer_model: X
# (We accept legacy `use_cloud` too — a real on-disk config still carries it.)
migrate_config() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  # Quick scan: do any legacy keys exist?
  local has_legacy=false
  while IFS='=' read -r k _; do
    k=$(echo "$k" | xargs)
    case "$k" in
      voice|tts_model|optimize_model|use_gcloud|use_cloud) has_legacy=true ;;
    esac
  done < "$CONFIG_FILE"
  [[ "$has_legacy" == false ]] && return 0

  info "migrating ~/.config/speak/config to the new schema…"

  # Read raw legacy values.
  local L_VOICE="" L_TTS_MODEL="" L_OPTIMIZE_MODEL="" L_GCLOUD=""
  while IFS='=' read -r key value; do
    [[ -z "$key" || "$key" == \#* ]] && continue
    key=$(echo "$key" | xargs); value=$(echo "$value" | xargs)
    case "$key" in
      voice) L_VOICE="$value" ;;
      tts_model) L_TTS_MODEL="$value" ;;
      optimize_model) L_OPTIMIZE_MODEL="$value" ;;
      use_gcloud|use_cloud) L_GCLOUD="$value" ;;
    esac
  done < "$CONFIG_FILE"

  # use_gcloud/use_cloud → engine (error on unmappable)
  if [[ -n "$L_GCLOUD" ]]; then
    case "$(tolower "$L_GCLOUD")" in
      true)  save_config_value "engine" "gcloud" ;;
      false) save_config_value "engine" "gemini" ;;
      *) err "config migration: cannot map use_gcloud='${L_GCLOUD}' (expected true|false)"; exit 1 ;;
    esac
    delete_config_value "use_gcloud"
    delete_config_value "use_cloud"
  fi

  # voice=Puck → persona: puck (lowercase-normalize; FAIL if no matching persona)
  if [[ -n "$L_VOICE" ]]; then
    local pid; pid="$(tolower "$L_VOICE")"
    if [[ "$(persona_exists "$pid"; echo $?)" != "0" ]]; then
      err "config migration: voice='${L_VOICE}' has no matching persona in voices.yaml"
      exit 1
    fi
    save_config_value "persona" "$pid"
    delete_config_value "voice"
  fi

  # tts_model=X → model_overrides.gemini=X (the legacy tts_model was Gemini's)
  if [[ -n "$L_TTS_MODEL" ]]; then
    save_config_value "model_overrides.gemini" "$L_TTS_MODEL"
    delete_config_value "tts_model"
  fi

  # optimize_model=X → optimizer_model: X
  if [[ -n "$L_OPTIMIZE_MODEL" ]]; then
    save_config_value "optimizer_model" "$L_OPTIMIZE_MODEL"
    delete_config_value "optimize_model"
  fi

  info "migration complete."
  # Reload so the rest of the run sees the migrated values.
  load_config
}

# ── Persona / engine resolution ──────────────────────────────────────
# Returns 0 if a persona id (already lowercased) exists.
persona_exists() {
  local pid="$1"
  local hit
  hit="$(yaml_query "$VOICES_YAML" "1 if '${pid}' in (d.get('personas') or {}) else 0")"
  [[ "$hit" == "1" ]]
}

# Canonical persona id from any-case input. Echoes lowercase id, returns 0 if
# it exists, else returns 1. (behavior #14 — case-insensitive lookup.)
canonical_persona() {
  local want; want="$(tolower "$1")"
  if persona_exists "$want"; then
    printf '%s' "$want"
    return 0
  fi
  return 1
}

# Validate an engine id.
engine_exists() {
  local e="$1"
  case "$e" in gemini|gcloud|kokoro) return 0 ;; *) return 1 ;; esac
}

# Engines that DO realize a given persona (space-separated). For the
# hard-error message and the coverage grid.
engines_realizing() {
  local pid="$1"
  yaml_query "$VOICES_YAML" "sorted((d['personas']['${pid}'].get('realizations') or {}).keys())"
}

# Does <engine> realize <persona>?
has_realization() {
  local pid="$1" engine="$2"
  local hit
  hit="$(yaml_query "$VOICES_YAML" "1 if '${engine}' in (d['personas']['${pid}'].get('realizations') or {}) else 0")"
  [[ "$hit" == "1" ]]
}

# Persona display fields: style|glyph|color
persona_fields() {
  local pid="$1"
  yaml_query "$VOICES_YAML" "'%s|%s|%s' % (d['personas']['${pid}'].get('style',''), d['personas']['${pid}'].get('glyph','?'), d['personas']['${pid}'].get('color','37'))"
}

# Resolve (persona, engine) → a realization spec the adapter understands.
# Echoes (one per line):
#   line 1: REALIZATION   (gemini: voice name; gcloud: full Chirp3 name;
#                          kokoro: voice id OR blend spec "v:w,v:w")
#   line 2: LANGUAGE_CODE (may be empty)
#   line 3: BADGE_NAME    (human label of what was ACTUALLY rendered)
# HARD ERROR (no fallback) is enforced by the caller via has_realization.
# (sc:resolve-voice; key-design-move PERSONA/REALIZATION split.)
resolve_realization() {
  local pid="$1" engine="$2"
  "$PYTHON" - "$VOICES_YAML" "$ENGINES_YAML" "$pid" "$engine" <<'PYEOF'
import sys, yaml
vpath, epath, pid, engine = sys.argv[1:5]
with open(vpath) as fh: voices = yaml.safe_load(fh)
with open(epath) as fh: engines = yaml.safe_load(fh)
r = voices["personas"][pid]["realizations"][engine]
native = (engines["engines"].get("kokoro") or {}).get("native_voices", {})

realization = ""
lang = ""
badge = ""

if engine == "kokoro":
    if "blend" in r:
        comps = r["blend"]
        pairs = []
        # locale from the FIRST component's native_voices entry (all components
        # of a blend share a locale family in our data); never inferred from
        # the bf_/bm_ string prefix.
        first = comps[0]["voice"]
        lang = (native.get(first, {}) or {}).get("language_code", "en-us")
        for c in comps:
            pairs.append("%s:%s" % (c["voice"], c["weight"]))
        realization = ",".join(pairs)
        names = "+".join(c["voice"] for c in comps)
        badge = "%s blend" % names
    else:
        v = r["voice"]
        realization = v
        lang = (native.get(v, {}) or {}).get("language_code", "en-us")
        badge = v
else:
    realization = r["voice"]
    lang = r.get("language_code", "")
    badge = r["voice"]

print(realization)
print(lang)
print(badge)
PYEOF
}

# Engine-level fields from engines.yaml.
engine_field() {
  local engine="$1" field="$2"
  yaml_query "$ENGINES_YAML" "(d['engines']['${engine}'].get('${field}'))"
}

engine_has_audio_tags() {
  local engine="$1"
  local hit
  hit="$(yaml_query "$ENGINES_YAML" "1 if 'audio-tags' in (d['engines']['${engine}'].get('capabilities') or []) else 0")"
  [[ "$hit" == "1" ]]
}

# Resolve a model: --model flag (key or literal) > model_overrides[engine] >
# engines.yaml models.default. A flag value that matches a models.<key>
# resolves to that key's id; otherwise it's treated as a literal id.
# Echoes the concrete model id (may be empty string for engines like gcloud
# whose models.default is null).
# Read the per-engine model override scalar (bash 3.2 indirection).
model_override_for() {
  local engine="$1" var="CFG_MODEL_OVERRIDE_$1"
  printf '%s' "${!var:-}"
}

resolve_model() {
  local engine="$1" flag="${2:-}"
  local override; override="$(model_override_for "$engine")"
  "$PYTHON" - "$ENGINES_YAML" "$engine" "$flag" "$override" <<'PYEOF'
import sys, yaml
epath, engine, flag, override = sys.argv[1:5]
with open(epath) as fh: engines = yaml.safe_load(fh)
e = engines["engines"][engine]
models = e.get("models") or {}
default_key = e.get("default_model")

def emit(v):
    print("" if v is None else v)

if flag:
    # key match first, else literal id
    if flag in models:
        emit(models[flag])
    else:
        emit(flag)
elif override:
    emit(override)
else:
    emit(models.get(default_key))
PYEOF
}

# ── Voice/persona badge (names the REALIZATION actually rendered) ────
# behavior #6: per-persona color+glyph identity; badge must show what was
# actually rendered (kills the lying-badge bug, behavior #6 CRITICAL). We
# print the persona glyph+name, and when the rendered realization differs
# (e.g. kokoro blend, or gcloud's prefixed name), append it; when identical
# (gemini Puck == persona Puck), collapse.
print_persona_badge() {
  local pid="$1" badge_name="${2:-}"
  local fields style glyph color
  fields="$(persona_fields "$pid")"
  IFS='|' read -r style glyph color <<< "$fields"
  # Persona display name = canonical-cap of the persona id (Title Case the id).
  local pname; pname="$(printf '%s' "$pid" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  printf "\033[${color}m${glyph} ${pname}\033[0m"
  # Collapse when the realization name equals the persona name (case-insensitive).
  if [[ -n "$badge_name" && "$(tolower "$badge_name")" != "$(tolower "$pname")" ]]; then
    printf " ${DIM}→ ${badge_name}${RESET}"
  fi
}

# ── Subcommands ──────────────────────────────────────────────────────
# `speak voices` — personas for the ACTIVE engine, marking realization;
# unrealized shown dimmed with reason. `--all` = persona×engine coverage grid.
cmd_voices() {
  local show_all=false
  [[ "${1:-}" == "--all" ]] && show_all=true

  local active_engine="$ENGINE"
  header
  echo "" >&2

  # default persona for the active-engine view
  local default_persona="$DATA_DEFAULT_PERSONA"
  [[ -n "$CFG_PERSONA" ]] && default_persona="$CFG_PERSONA"

  if [[ "$show_all" == true ]]; then
    echo -e "${BOLD}Persona × engine coverage${RESET}  ${DIM}(✓ realized · · unavailable)${RESET}" >&2
    echo -e "${DIM}──────────────────────────────────────────────${RESET}" >&2
    printf "  %-16s ${DIM}%-8s %-8s %-8s${RESET}\n" "persona" "gemini" "gcloud" "kokoro" >&2
    # iterate personas in file order
    local pid
    while IFS= read -r pid; do
      [[ -z "$pid" ]] && continue
      local fields style glyph color
      fields="$(persona_fields "$pid")"
      IFS='|' read -r style glyph color <<< "$fields"
      local g c k
      g="·"; c="·"; k="·"
      has_realization "$pid" gemini && g="✓"
      has_realization "$pid" gcloud && c="✓"
      has_realization "$pid" kokoro && k="✓"
      printf "  \033[${color}m${glyph} %-14s\033[0m %-8s %-8s %-8s\n" "$pid" "$g" "$c" "$k" >&2
    done < <(yaml_query "$VOICES_YAML" "list(d['personas'].keys())")
    echo "" >&2
    echo -e "${DIM}Active engine: ${active_engine}. Realizations are declared in voices.yaml.${RESET}" >&2
    return
  fi

  local elabel; elabel="$(engine_field "$active_engine" label)"
  echo -e "${BOLD}Personas for ${elabel}${RESET} ${DIM}(engine: ${active_engine})${RESET}" >&2
  echo -e "${DIM}──────────────────────────────────${RESET}" >&2
  local pid
  while IFS= read -r pid; do
    [[ -z "$pid" ]] && continue
    local fields style glyph color
    fields="$(persona_fields "$pid")"
    IFS='|' read -r style glyph color <<< "$fields"
    local marker=""
    if [[ "$(tolower "$pid")" == "$(tolower "$default_persona")" ]]; then
      marker=" ${GREEN}← default${RESET}"
    fi
    if has_realization "$pid" "$active_engine"; then
      printf "  \033[${color}m${glyph}  %-16s\033[0m ${DIM}%s${RESET}%b\n" "$pid" "$style" "$marker" >&2
    else
      # unrealized in active engine: dim it and name a reason
      local realizers; realizers="$(engines_realizing "$pid" | tr '\n' ' ')"
      printf "  ${DIM}%s  %-16s  (no ${active_engine} realization — try: %s)${RESET}\n" "$glyph" "$pid" "$realizers" >&2
    fi
  done < <(yaml_query "$VOICES_YAML" "list(d['personas'].keys())")
  echo "" >&2
  echo -e "${DIM}Coverage grid: speak voices --all   ·   Set default: speak set persona <name>${RESET}" >&2
}

# `speak set engine|persona|model …` mirrors config. No-arg shows config.
cmd_set() {
  if [[ $# -lt 1 ]]; then
    # show current config with a persona badge
    header
    echo "" >&2
    echo -e "${BOLD}Current config${RESET} ${DIM}(${CONFIG_FILE})${RESET}" >&2
    echo -e "${DIM}──────────────────────────────────${RESET}" >&2
    echo -e "  engine          ${DIM}${ENGINE}${RESET}" >&2
    local persona; persona="$DATA_DEFAULT_PERSONA"; [[ -n "$CFG_PERSONA" ]] && persona="$CFG_PERSONA"
    echo -ne "  persona         " >&2
    local rname rlang rbadge
    if has_realization "$persona" "$ENGINE"; then
      { IFS= read -r rname; IFS= read -r rlang; IFS= read -r rbadge; } < <(resolve_realization "$persona" "$ENGINE")
      print_persona_badge "$persona" "$rbadge" >&2
    else
      print_persona_badge "$persona" "" >&2
      echo -ne "  ${DIM}(no ${ENGINE} realization)${RESET}" >&2
    fi
    echo "" >&2
    local mdl; mdl="$(resolve_model "$ENGINE" "")"
    echo -e "  model           ${DIM}${mdl:-<engine default>}${RESET}" >&2
    echo -e "  optimizer_model ${DIM}${OPTIMIZER_MODEL}${RESET}" >&2
    local oe
    for oe in gemini gcloud kokoro; do
      local ov; ov="$(model_override_for "$oe")"
      [[ -n "$ov" ]] && echo -e "  ${DIM}override ${oe} = ${ov}${RESET}" >&2
    done
    echo "" >&2
    return
  fi

  local key="$1" value="${2:-}"
  case "$key" in
    engine)
      if [[ -z "$value" ]] || ! engine_exists "$value"; then
        err "Invalid engine: '${value:-}'. Must be one of: gemini, gcloud, kokoro"
        exit 1
      fi
      save_config_value "engine" "$value"
      echo -e "${GREEN}✓${RESET} engine set to ${BOLD}${value}${RESET}" >&2
      ;;
    persona|voice)  # accept legacy alias 'voice' but operate on personas
      local pid
      if ! pid="$(canonical_persona "$value")"; then
        err "Unknown persona: ${value:-}"
        echo -e "${DIM}Run 'speak voices' to see options${RESET}" >&2
        exit 1
      fi
      save_config_value "persona" "$pid"
      echo -ne "${GREEN}✓${RESET} Default persona set to " >&2
      print_persona_badge "$pid" "" >&2
      echo "" >&2
      ;;
    model)
      # speak set model <id>           → override active engine's model
      # speak set model <engine> <id>  → override a specific engine's model
      local target_engine="$ENGINE" model_val="$value"
      if [[ $# -ge 3 ]] && engine_exists "$value"; then
        target_engine="$value"; model_val="$3"
      fi
      if [[ -z "$model_val" ]]; then
        err "Usage: speak set model <id>   |   speak set model <engine> <id>"
        exit 1
      fi
      save_config_value "model_overrides.${target_engine}" "$model_val"
      echo -e "${GREEN}✓${RESET} model_overrides.${target_engine} set to ${BOLD}${model_val}${RESET}" >&2
      ;;
    optimizer_model)
      [[ -z "$value" ]] && { err "Usage: speak set optimizer_model <model>"; exit 1; }
      save_config_value "optimizer_model" "$value"
      echo -e "${GREEN}✓${RESET} optimizer_model set to ${BOLD}${value}${RESET}" >&2
      ;;
    *)
      err "Unknown config key: $key"
      echo -e "${DIM}Valid keys: engine, persona, model, optimizer_model${RESET}" >&2
      exit 1
      ;;
  esac
}

