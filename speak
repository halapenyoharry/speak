# ── Text chunking (engine-agnostic) ──────────────────────────────────
# behavior #2: paragraph-then-sentence split at 500 words, re-joined with
# '\n\n'. Exact algorithm preserved verbatim from the original driver.
CHUNK_MAX_WORDS=500

chunk_text() {
  local text="$1"
  "$PYTHON" -c "
import sys, json

text = sys.argv[1]
max_words = int(sys.argv[2])

# Split on double newlines (paragraphs)
paragraphs = [p.strip() for p in text.split('\n\n') if p.strip()]

chunks = []
current_chunk = []
current_words = 0

for para in paragraphs:
    para_words = len(para.split())
    # If a single paragraph exceeds max, split it by sentences
    if para_words > max_words:
        import re
        sentences = re.split(r'(?<=[.!?])\s+', para)
        for sent in sentences:
            sent_words = len(sent.split())
            if current_words + sent_words > max_words and current_chunk:
                chunks.append('\n\n'.join(current_chunk))
                current_chunk = [sent]
                current_words = sent_words
            else:
                current_chunk.append(sent)
                current_words += sent_words
    elif current_words + para_words > max_words and current_chunk:
        chunks.append('\n\n'.join(current_chunk))
        current_chunk = [para]
        current_words = para_words
    else:
        current_chunk.append(para)
        current_words += para_words

if current_chunk:
    chunks.append('\n\n'.join(current_chunk))

# Output as JSON array
print(json.dumps(chunks))
" "$text" "$CHUNK_MAX_WORDS"
}

# ── Optimizer (narration director) ───────────────────────────────────
# Gated on the ACTIVE engine's audio-tags capability AND GEMINI_API_KEY.
# The optimizer is itself a Gemini text call (engines.yaml optimizer.model).
# Echoes the optimized transcript on stdout; writes "p/c" token string to the
# file named by $1. Returns nonzero on failure.
run_optimizer() {
  local tokens_out="$1" input_text="$2"
  local api_base; api_base="$(engine_field gemini endpoint)"

  local combined_text="You are a narration director. Given the following text, produce an optimized transcript for text-to-speech narration by a single speaker.

Rules:
- Keep ALL original content and meaning intact. Do not summarize or cut.
- Add audio tags in square brackets where they improve delivery: [pause], [slowly], [excited], [whispers], [serious], [warmly], etc.
- Add natural pacing cues.
- If the text is prose or an article, add a brief style and pace direction at the top.
- Output ONLY the optimized transcript. No explanations, no markdown fences.

TEXT TO OPTIMIZE:
${input_text}"

  local escaped_combined
  escaped_combined=$(json_escape "$combined_text")

  local narration_response
  narration_response=$(curl -s "${api_base}/${OPTIMIZER_MODEL}:generateContent" \
    -H "x-goog-api-key: ${GEMINI_API_KEY}" \
    -H "Content-Type: application/json" \
    -d "{
      \"contents\": [{
        \"parts\": [{\"text\": ${escaped_combined}}]
      }],
      \"generationConfig\": {
        \"temperature\": 0.7
      }
    }")

  local transcript
  transcript=$(echo "$narration_response" | "$PYTHON" -c "
import json, sys
data = json.load(sys.stdin)
try:
    text = data['candidates'][0]['content']['parts'][0]['text']
    print(text)
except (KeyError, IndexError):
    print('Error: ' + json.dumps(data, indent=2), file=sys.stderr)
    sys.exit(1)
") || return 1

  echo "$narration_response" | "$PYTHON" -c "
import json, sys
data = json.load(sys.stdin)
try:
    u = data.get('usageMetadata', {})
    print(f\"{u.get('promptTokenCount', '?')}/{u.get('candidatesTokenCount', '?')}\")
except: print('?/?')
" > "$tokens_out" 2>/dev/null || echo "?/?" > "$tokens_out"

  printf '%s' "$transcript"
}

# ── Main speak logic ─────────────────────────────────────────────────
cmd_speak() {
  local persona_flag=""
  local engine_flag=""
  local model_flag=""
  local raw=false
  local clipboard=false
  local output=""
  local play=true
  local quiet=false
  local use_stdout=false
  local json_out=false
  local show_mode=""

  # Parse options (clean-slate CLI surface). No -g/-k/-f/--no-gcloud;
  # mutual-exclusion guard deleted by construction (single engine value).
  while [[ $# -gt 0 ]]; do
    # Expand combined short boolean flags (e.g., -rc -> -r -c)
    if [[ "$1" =~ ^-[rcq]{2,}$ ]]; then
      local expanded=()
      for (( i=1; i<${#1}; i++ )); do
        expanded+=("-${1:$i:1}")
      done
      shift
      set -- "${expanded[@]}" "$@"
      continue
    fi

    case "$1" in
      -e|--engine) engine_flag="$2"; shift 2 ;;
      -m|--model) model_flag="$2"; shift 2 ;;
      -v|--voice) persona_flag="$2"; shift 2 ;;
      -r|--raw) raw=true; shift ;;
      -c|--clipboard) clipboard=true; shift ;;
      -o|--output) output="$2"; play=false; shift 2 ;;
      -q|--quiet) quiet=true; shift ;;
      --stdout) use_stdout=true; play=false; quiet=true; shift ;;
      --json) json_out=true; play=false; quiet=true; shift ;;
      -s|--show)
        case "${2:-}" in
          wave|waveform|spec|spectrogram) show_mode="$2"; shift 2 ;;
          *) show_mode="wave"; shift ;;
        esac ;;
      --) shift; break ;;
      -*) err "Unknown option: $1"; echo -e "${DIM}Run 'speak --help'${RESET}" >&2; exit 1 ;;
      *) break ;;
    esac
  done

  # Resolve active engine: --engine flag > config > engine of the default persona.
  local engine="$ENGINE"
  if [[ -n "$engine_flag" ]]; then
    if ! engine_exists "$engine_flag"; then
      err "Invalid engine: '${engine_flag}'. Must be one of: gemini, gcloud, kokoro"
      exit 1
    fi
    engine="$engine_flag"
  fi

  # Resolve persona: -v flag > config persona > data default_persona.
  local persona="$DATA_DEFAULT_PERSONA"
  [[ -n "$CFG_PERSONA" ]] && persona="$CFG_PERSONA"
  if [[ -n "$persona_flag" ]]; then
    persona="$persona_flag"
  fi
  local pid
  if ! pid="$(canonical_persona "$persona")"; then
    err "Unknown persona: $persona"
    echo -e "${DIM}Run 'speak voices' to see options${RESET}" >&2
    exit 1
  fi
  persona="$pid"

  # HARD ERROR on missing realization (policy:missing-realization).
  # No --nearest, no fallback, no default realization. Name the engines that
  # DO realize the persona. (behaviors: missing-realization decision #1)
  if ! has_realization "$persona" "$engine"; then
    local realizers; realizers="$(engines_realizing "$persona" | tr '\n' ' ')"
    err "Persona '${persona}' has no realization in engine '${engine}'."
    if [[ -n "${realizers// }" ]]; then
      echo -e "${DIM}It IS realized by: ${realizers}${RESET}" >&2
      echo -e "${DIM}Try:  speak -e <engine> -v ${persona} …${RESET}" >&2
    else
      echo -e "${DIM}No engine realizes this persona (data inconsistency).${RESET}" >&2
    fi
    exit 1
  fi

  # Resolve the concrete realization the adapter will render + its badge.
  local realization language_code badge_name
  { IFS= read -r realization; IFS= read -r language_code; IFS= read -r badge_name; } \
    < <(resolve_realization "$persona" "$engine")

  # Resolve concrete model id (key→id; precedence handled in resolve_model).
  local model_id; model_id="$(resolve_model "$engine" "$model_flag")"

  # Optimizer gating: fire IFF active engine lists audio-tags AND GEMINI_API_KEY
  # set. Under gcloud/kokoro (empty capabilities) the optimizer is SKIPPED
  # entirely — kokoro is offline by default, no key required. (behavior #12 —
  # deliberate behavior CHANGE from the old kokoro-without-raw path.)
  local do_optimize=false
  if [[ "$raw" == false ]] && engine_has_audio_tags "$engine"; then
    if [[ -n "${GEMINI_API_KEY:-}" ]]; then
      do_optimize=true
    else
      err "GEMINI_API_KEY not set (required to optimize for engine '${engine}')."
      echo -e "${DIM}export GEMINI_API_KEY=\"your-key-here\"   (or use -r to skip optimization)${RESET}" >&2
      exit 1
    fi
  fi

  # gemini synthesis itself also needs the key, independent of optimization.
  if [[ "$engine" == "gemini" && -z "${GEMINI_API_KEY:-}" ]]; then
    err "GEMINI_API_KEY not set (required for gemini synthesis)."
    echo -e "${DIM}export GEMINI_API_KEY=\"your-key-here\"${RESET}" >&2
    exit 1
  fi

  # Pre-resolve gcloud credentials ONCE before fanning out (behavior #11).
  if [[ "$engine" == "gcloud" ]]; then
    local access_token
    access_token=$(gcloud auth application-default print-access-token 2>/dev/null || gcloud auth print-access-token 2>/dev/null || echo "")
    if [[ -z "$access_token" ]]; then
      err "Google Cloud SDK credentials not found."
      echo -e "${DIM}Please run: gcloud auth application-default login${RESET}" >&2
      exit 1
    fi
    export GCLOUD_ACCESS_TOKEN="$access_token"
    local gcp_project project_fallback
    project_fallback="$(engine_field gcloud project_fallback)"
    gcp_project=$(gcloud config get-value project 2>/dev/null || echo "")
    [[ -z "$gcp_project" ]] && gcp_project="$project_fallback"
    export GCLOUD_PROJECT="$gcp_project"
  fi

  # Get input text (behavior #7: cross-platform clipboard).
  local input_text=""
  if [[ "$clipboard" == true ]]; then
    if command -v pbpaste &>/dev/null; then
      input_text="$(pbpaste)"
    elif command -v xclip &>/dev/null; then
      input_text="$(xclip -selection clipboard -o)"
    elif command -v xsel &>/dev/null; then
      input_text="$(xsel --clipboard)"
    elif command -v wl-paste &>/dev/null; then
      input_text="$(wl-paste)"
    else
      err "No clipboard tool found (pbpaste, xclip, xsel, wl-paste)"
      exit 1
    fi
  elif [[ $# -gt 0 ]]; then
    input_text="$*"
  else
    input_text="$(cat)"
  fi
  if [[ -z "$input_text" ]]; then
    err "No input text provided"
    exit 1
  fi

  # ── tmpdir lifecycle via trap (behavior #20: guaranteed cleanup) ───
  # Use a script-global so the EXIT trap can reference it safely under `set -u`
  # (a function-local would be out of scope when the trap fires).
  SPEAK_TMPDIR=$(mktemp -d)
  trap 'rm -rf "${SPEAK_TMPDIR:-}"' EXIT
  local tmpdir="$SPEAK_TMPDIR"
  local wav_file="${tmpdir}/out.wav"

  # ── Header + badge (badge names the realization ACTUALLY rendered) ──
  header
  echo -ne "  ${GRAY}voice${RESET}  " >&2
  print_persona_badge "$persona" "$badge_name" >&2
  echo -ne "  ${BLUE}$(engine_field "$engine" label)${RESET}" >&2
  if [[ "$raw" == true ]]; then
    echo -ne "  ${YELLOW}raw${RESET}" >&2
  fi
  if [[ "$do_optimize" == false && "$raw" == false ]]; then
    # optimizer skipped because engine doesn't consume audio-tags
    echo -ne "  ${DIM}no-optimize${RESET}" >&2
  fi
  echo "" >&2

  # ── Step 1: Narration optimization (capability-gated) ──────────────
  local transcript=""
  local optimize_tokens=""
  if [[ "$do_optimize" == true ]]; then
    echo -ne "  ${GRAY}optimizing...${RESET}" >&2
    local opt_tok_file="${tmpdir}/opt.tokens"
    if ! transcript=$(run_optimizer "$opt_tok_file" "$input_text"); then
      echo -ne "\r\033[K" >&2
      err "Narration optimization failed"
      exit 1
    fi
    optimize_tokens="$(cat "$opt_tok_file" 2>/dev/null || echo '?/?')"
    echo -ne "\r\033[K" >&2

    if [[ "$quiet" == false ]]; then
      echo -e "  ${GRAY}──────────────────────────────────${RESET}" >&2
      # behavior #15: highlight bracketed tags yellow, dimmed, between rules.
      echo "$transcript" | sed -E "
        s/\[([^]]+)\]/$(printf '\033[33m')[\1]$(printf '\033[0m\033[2m')/g
      " | while IFS= read -r line; do
        echo -e "  ${DIM}${line}${RESET}" >&2
      done
      echo -e "  ${GRAY}──────────────────────────────────${RESET}" >&2
    fi
  else
    transcript="$input_text"
  fi

  # ── Step 2: synthesis (chunk if > 500 words) → ordered WAV chunks ──
  local adapter; adapter="$(engine_adapter_path "$engine")"
  if [[ -z "$adapter" || ! -f "$adapter" ]]; then
    err "Engine adapter not found for '${engine}' (looked in ${ENGINES_DIR})."
    echo -e "${DIM}Expected: engines/${engine}.sh or engines/${engine}.py${RESET}" >&2
    exit 1
  fi
  local max_in_flight; max_in_flight="$(engine_field "$engine" max_in_flight)"
  [[ -z "$max_in_flight" || "$max_in_flight" -lt 1 ]] 2>/dev/null && max_in_flight=1

  local tts_tokens="?/?"
  local word_count
  word_count=$(echo "$transcript" | wc -w | xargs)

  if [[ "$word_count" -gt "$CHUNK_MAX_WORDS" ]]; then
    # Chunked mode — bounded-parallel at max_in_flight (behavior #3).
    local chunks_json
    chunks_json=$(chunk_text "$transcript")
    local num_chunks
    num_chunks=$(echo "$chunks_json" | "$PYTHON" -c "import json,sys; print(len(json.load(sys.stdin)))")

    echo -e "  ${GRAY}generating audio...${RESET} ${DIM}${num_chunks} chunks, ${word_count} words${RESET}" >&2

    local chunk_files=()
    local completed=0

    # Process in batches of max_in_flight (cloud=3, kokoro=1 → serial).
    local batch_start
    for batch_start in $(seq 0 "$max_in_flight" $((num_chunks - 1))); do
      local batch_end=$((batch_start + max_in_flight - 1))
      if [[ $batch_end -ge $num_chunks ]]; then
        batch_end=$((num_chunks - 1))
      fi
      local batch_pids=()
      local i
      for i in $(seq "$batch_start" "$batch_end"); do
        local chunk
        chunk=$(echo "$chunks_json" | "$PYTHON" -c "import json,sys; print(json.load(sys.stdin)[$i])")
        local chunk_wav="${tmpdir}/chunk_${i}.wav"
        chunk_files+=("$chunk_wav")
        dispatch_adapter "$adapter" "$chunk" "$chunk_wav" "$realization" "$model_id" "$language_code" &
        batch_pids+=($!)
      done
      local pid_w
      for pid_w in "${batch_pids[@]}"; do
        wait "$pid_w" || true
        completed=$((completed + 1))
        echo -ne "\r  ${GRAY}generating audio...${RESET} ${DIM}${completed}/${num_chunks}${RESET}  " >&2
      done
    done
    echo "" >&2

    # behavior #4: partial-failure tolerance — collect .err, print, continue.
    local failed_chunks=()
    local f
    for f in "${chunk_files[@]}"; do
      if [[ -f "${f}.err" ]]; then
        failed_chunks+=("$(cat "${f}.err")")
      fi
    done
    if [[ ${#failed_chunks[@]} -gt 0 ]]; then
      err "${#failed_chunks[@]} chunk(s) failed"
      local msg
      for msg in "${failed_chunks[@]}"; do
        echo -e "  ${DIM}${msg}${RESET}" >&2
      done
    fi

    # Collect valid WAVs in chunk order.
    local valid_wavs=()
    for f in "${chunk_files[@]}"; do
      [[ -f "$f" ]] && valid_wavs+=("$f")
    done
    if [[ ${#valid_wavs[@]} -eq 0 ]]; then
      err "All chunks failed"
      exit 1
    fi

    # behavior #5: ordered ffmpeg concat (single chunk → cp; many → concat).
    if [[ ${#valid_wavs[@]} -eq 1 ]]; then
      cp "${valid_wavs[0]}" "$wav_file"
    else
      local concat_list="${tmpdir}/concat.txt"
      for f in "${valid_wavs[@]}"; do
        echo "file '${f}'" >> "$concat_list"
      done
      ffmpeg -y -loglevel error -f concat -safe 0 -i "$concat_list" -c copy "$wav_file"
    fi

    # behavior #9: aggregate token counts across chunks (engine convention).
    tts_tokens="$(aggregate_tokens "$engine" "${chunk_files[@]}")"

  else
    # Single-chunk mode — one adapter invocation.
    echo -ne "  ${GRAY}generating audio...${RESET}" >&2
    if ! dispatch_adapter "$adapter" "$transcript" "$wav_file" "$realization" "$model_id" "$language_code"; then
      local err_msg="TTS generation failed"
      [[ -f "${wav_file}.err" ]] && err_msg=$(cat "${wav_file}.err")
      echo "" >&2
      err "$err_msg"
      exit 1
    fi
    tts_tokens="$(aggregate_tokens "$engine" "$wav_file")"
    echo -ne "\r\033[K" >&2
  fi

  # ── Duration probe + human-friendly format (behavior #16) ──────────
  local duration
  duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$wav_file" 2>/dev/null | cut -d. -f1 || echo "?")
  local dur_display
  if [[ "$duration" != "?" && "$duration" -gt 0 ]] 2>/dev/null; then
    local mins=$((duration / 60))
    local secs=$((duration % 60))
    if [[ $mins -gt 0 ]]; then
      dur_display="${mins}m${secs}s"
    else
      dur_display="${secs}s"
    fi
  else
    dur_display="~"
  fi

  # ── Summary line (behavior #9 token display) ───────────────────────
  echo -ne "\r\033[K" >&2
  echo -ne "  ${GRAY}duration${RESET}  ${dur_display}" >&2
  echo -ne "    ${GRAY}tokens${RESET}  " >&2
  if [[ "$do_optimize" == true ]]; then
    echo -ne "${DIM}opt:${optimize_tokens} tts:${tts_tokens}${RESET}" >&2
  else
    echo -ne "${DIM}tts:${tts_tokens}${RESET}" >&2
  fi
  echo "" >&2

  # ── Output routing (behavior #8): exact field names + side effects ─
  if [[ "$use_stdout" == true ]]; then
    cat "$wav_file"
  elif [[ "$json_out" == true ]]; then
    local wav_b64
    wav_b64=$(base64 < "$wav_file" | tr -d '\n')
    local opt_tok="${optimize_tokens:-}"
    local escaped_transcript
    escaped_transcript=$(json_escape "$transcript")
    local is_raw="false"
    [[ "$raw" == true ]] && is_raw="true"
    # `voice` field carries the rendered realization badge so the JSON, like
    # the on-screen badge, reports what was ACTUALLY rendered.
    "$PYTHON" -c "
import json, sys
meta = {
    'voice': sys.argv[1],
    'duration_seconds': int(sys.argv[2]) if sys.argv[2].isdigit() else None,
    'raw': sys.argv[3] == 'true',
    'tokens': {
        'optimize': sys.argv[4] if sys.argv[4] else None,
        'tts': sys.argv[5]
    },
    'transcript': json.loads(sys.argv[6]),
    'audio_wav_base64': sys.argv[7]
}
print(json.dumps(meta, indent=2))
" "$badge_name" "${duration:-0}" "$is_raw" "$opt_tok" "$tts_tokens" "$escaped_transcript" "$wav_b64"
  elif [[ "$play" == true ]]; then
    if [[ -n "$show_mode" ]] && command -v ffplay &>/dev/null; then
      local ff_showmode=1
      local mode_label="waveform"
      case "$show_mode" in
        spec|spectrogram) ff_showmode=2; mode_label="spectrogram" ;;
        wave|waveform)    ff_showmode=1; mode_label="waveform" ;;
      esac
      echo -e "  ${GREEN}▶${RESET} ${DIM}${mode_label}${RESET}" >&2
      ffplay -autoexit -showmode "$ff_showmode" -window_title "speak: ${badge_name}" -loglevel quiet "$wav_file" 2>/dev/null
    else
      echo -ne "  ${GREEN}▶${RESET} ${DIM}playing...${RESET}" >&2
      if command -v afplay &>/dev/null; then
        afplay "$wav_file"
      elif command -v paplay &>/dev/null; then
        paplay "$wav_file"
      elif command -v aplay &>/dev/null; then
        aplay "$wav_file"
      elif command -v mpv &>/dev/null; then
        mpv --no-video --really-quiet "$wav_file"
      else
        echo "" >&2
        err "No audio player found"
        echo -e "  ${DIM}Saved to: ${wav_file}${RESET}" >&2
        # Disarm cleanup so the user can recover the file.
        trap - EXIT
        exit 0
      fi
    fi
    echo -ne "\r\033[K" >&2
    echo -e "  ${GREEN}✓${RESET} ${DIM}done${RESET}" >&2
  else
    cp "$wav_file" "$output"
    echo -e "  ${GREEN}✓${RESET} ${DIM}saved → ${output}${RESET}" >&2
  fi
  # tmpdir cleaned by the EXIT trap.
}

# ── Adapter dispatch (per CONTRACT.md §1) ────────────────────────────
# engines/<engine>.{sh,py} --realization <R> --output <WAV> [--model <M>]
#   [--language-code <LC>]   (text on stdin)
# .sh adapters are invoked via bash; .py adapters via the resolved $PYTHON.
engine_adapter_path() {
  local engine="$1"
  if [[ -f "${ENGINES_DIR}/${engine}.sh" ]]; then
    printf '%s' "${ENGINES_DIR}/${engine}.sh"
  elif [[ -f "${ENGINES_DIR}/${engine}.py" ]]; then
    printf '%s' "${ENGINES_DIR}/${engine}.py"
  else
    printf ''
  fi
}

# dispatch_adapter <adapter> <text> <wav> <realization> <model_id> <lang>
# Pipes text on stdin (CONTRACT §2). Returns the adapter's exit status WITHOUT
# aborting the parent (callers wrap in `|| true` under batches; single-chunk
# checks the status). The adapter writes .tokens/.err sidecars itself.
dispatch_adapter() {
  local adapter="$1" text="$2" wav="$3" realization="$4" model_id="$5" lang="$6"
  local -a args=(--realization "$realization" --output "$wav")
  [[ -n "$model_id" ]] && args+=(--model "$model_id")
  [[ -n "$lang" ]] && args+=(--language-code "$lang")
  case "$adapter" in
    *.py) printf '%s' "$text" | "$PYTHON" "$adapter" "${args[@]}" ;;
    *.sh) printf '%s' "$text" | bash "$adapter" "${args[@]}" ;;
    *)    printf '%s' "$text" | "$adapter" "${args[@]}" ;;
  esac
}

# aggregate_tokens <engine> <wav...>  → "p/c"  (or "local" for kokoro)
# Reads each <wav>.tokens (prompt,completion). For kokoro, the literal "local"
# is surfaced verbatim. (behavior #9)
aggregate_tokens() {
  local engine="$1"; shift
  if [[ "$engine" == "kokoro" ]]; then
    printf 'local'
    return
  fi
  local total_prompt=0 total_completion=0 f tok_line tp tc
  for f in "$@"; do
    if [[ -f "${f}.tokens" ]]; then
      tok_line=$(cat "${f}.tokens")
      # tolerate a literal "local" if an adapter wrote it
      if [[ "$tok_line" == "local" ]]; then
        printf 'local'
        return
      fi
      tp=$(echo "$tok_line" | cut -d, -f1)
      tc=$(echo "$tok_line" | cut -d, -f2)
      [[ "$tp" =~ ^[0-9]+$ ]] && total_prompt=$((total_prompt + tp))
      [[ "$tc" =~ ^[0-9]+$ ]] && total_completion=$((total_completion + tc))
    fi
  done
  printf '%s/%s' "$total_prompt" "$total_completion"
}

# ── Entry point ──────────────────────────────────────────────────────
# Validate data BEFORE anything reads it (fail loud). Then migrate config
# (once), load it, and resolve the active engine for subcommands.
validate_data
load_config
migrate_config

# Active engine: config > each engine self-declares default_persona, but the
# engine itself defaults to gemini when config is silent (the historical
# default_use_gcloud=false → gemini).
ENGINE="${CFG_ENGINE:-gemini}"
if ! engine_exists "$ENGINE"; then
  err "Config engine '${ENGINE}' is invalid. Run: speak set engine gemini|gcloud|kokoro"
  exit 1
fi

case "${1:-}" in
  voices)    shift; cmd_voices "${1:-}" ;;
  set)       shift; cmd_set "$@" ;;
  --help)    cmd_help ;;
  --version) echo "speak v${VERSION}" ;;
  *)         cmd_speak "$@" ;;
esac
